local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/ValoranterDev/Obs0/refs/heads/main/Library.lua"))()

local repoForAddons = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local ThemeManager = loadstring(game:HttpGet(repoForAddons .. "addons/ThemeManager.lua"))()
local SaveManager  = loadstring(game:HttpGet(repoForAddons .. "addons/SaveManager.lua"))()

local Options = Library.Options
local Toggles = Library.Toggleslocal function CreateAetherHub()
    if KeySystemGui then KeySystemGui:Destroy() end

    local Window = Library:CreateWindow({
        Title = "Aether Hub",
        Center = true,
        AutoShow = true,
        Resizable = false,
        NotifySide = "Right",
        ShowCustomCursor = true,
        Size = UDim2.new(0, 620, 0, 420),
    })

    local Tabs = {
        Main   = Window:AddTab("Principal", "home"),
        Extra  = Window:AddTab("Extras", "star"),
        Visual = Window:AddTab("Visuals", "eye"),
        Config = Window:AddTab("Config", "settings"),
    }

    -- Aplicar tema roxo neon
    Library.AccentColor = THEME.PurpleLight
    if Options.AccentColor then
        pcall(function() Options.AccentColor:SetValueRGB(THEME.PurpleLight) end)
    end

    ---------------------------------------------------------------
    -- ABA PRINCIPAL
    ---------------------------------------------------------------
    local MainGroup = Tabs.Main:AddLeftGroupbox("Aether Toggles", "zap")

    MainGroup:AddToggle("Toggle1", {
        Text = "Aimbot Silencioso",
        Default = false,
        Tooltip = "Ativa o Aimbot suave",
        Callback = function(v)
            Library:Notify({ Title = "Aether Hub", Description = "Aimbot: " .. tostring(v), Time = 2 })
        end
    })

    MainGroup:AddToggle("Toggle2", {
        Text = "ESP Jogadores",
        Default = false,
        Tooltip = "Mostra caixas nos jogadores",
    })

    MainGroup:AddToggle("Toggle3", {
        Text = "Speed Hack",
        Default = false,
    })

    MainGroup:AddToggle("Toggle4", {
        Text = "Infinite Jump",
        Default = false,
    })

    local ExtraGroup = Tabs.Main:AddRightGroupbox("Configurações", "sliders")

    ExtraGroup:AddSlider("Slider1", {
        Text = "Velocidade",
        Default = 16,
        Min = 1,
        Max = 250,
        Rounding = 0,
    })

    ExtraGroup:AddSlider("Slider2", {
        Text = "Força do Pulo",
        Default = 50,
        Min = 1,
        Max = 500,
        Rounding = 0,
    })

    ExtraGroup:AddDropdown("Dropdown1", {
        Values = { "Baixo", "Médio", "Alto", "Extremo" },
        Default = 2,
        Multi = false,
        Text = "Nível",
    })

    ExtraGroup:AddButton({
        Text = "Resetar Configurações",
        Func = function()
            Library:Notify({ Title = "Aether Hub", Description = "Configurações resetadas!", Time = 2 })
        end,
    })

    ---------------------------------------------------------------
    -- ABA EXTRAS
    ---------------------------------------------------------------
    local ExGroup = Tabs.Extra:AddLeftGroupbox("Utilidades", "wrench")
    ExGroup:AddButton({
        Text = "Rejoin Server",
        Func = function()
            game:GetService("TeleportService"):Teleport(game.PlaceId, Player)
        end,
    })
    ExGroup:AddButton({
        Text = "Server Hop",
        Func = function()
            Library:Notify({ Title = "Aether Hub", Description = "Server Hop em breve...", Time = 2 })
        end,
    })

    ---------------------------------------------------------------
    -- ABA VISUAL
    ---------------------------------------------------------------
    local VisGroup = Tabs.Visual:AddLeftGroupbox("ESP Visual", "eye")
    VisGroup:AddToggle("ESPBox", { Text = "Box ESP", Default = false })
        :AddColorPicker("ESPBoxColor", { Default = THEME.PurpleLight, Title = "Cor da Box" })

    VisGroup:AddToggle("ESPTracer", { Text = "Tracer ESP", Default = false })
        :AddColorPicker("ESPTracerColor", { Default = THEME.PurpleLight, Title = "Cor do Tracer" })

    VisGroup:AddToggle("ESPName", { Text = "Name ESP", Default = false })

    ---------------------------------------------------------------
    -- ABA CONFIG
    ---------------------------------------------------------------
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "MenuBind" })

    ThemeManager:SetFolder("aetherhub")
    SaveManager:SetFolder("aetherhub/configs")

    SaveManager:BuildConfigSection(Tabs.Config)
    ThemeManager:ApplyToTab(Tabs.Config)

    task.spawn(function()
        task.wait(0.1)
        if Options.AccentColor then
            pcall(function() Options.AccentColor:SetValueRGB(THEME.PurpleLight) end)
        end
    end)

    ---------------------------------------------------------------
    -- MENU BIND + UNLOAD
    ---------------------------------------------------------------
    Tabs.Config:AddLeftGroupbox("Menu", "menu"):AddLabel("Menu Keybind"):AddKeyPicker("MenuBind", {
        Default = "RightShift",
        NoUI = true,
        Text = "Toggle Menu",
    })
    Library.ToggleKeybind = Options.MenuBind

    Tabs.Config:AddLeftGroupbox("Danger", "alert-triangle"):AddButton({
        Text = "Unload Aether Hub",
        Func = function()
            Library:Unload()
            _G.AetherHubLoaded = false
        end,
    })

    _G.AetherHubUI = Library

    Library:Notify({
        Title = "Aether Hub",
        Description = "Hub carregado com sucesso!",
        Time = 4
    })
endlocal function CheckKey()
    if KBox.Text == "AETHER-X" then
        KBtn.Text = "✔ ACESSO LIBERADO"
        KBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        task.wait(0.6)
        CreateAetherHub()
    else
        KBox.Text = ""
        KBox.PlaceholderText = "❌ Key Incorreta!"
        KBox.PlaceholderColor3 = THEME.Red
        local shake = TweenService:Create(
            KeyFrame,
            TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 4, true),
            { Position = KeyFrame.Position + UDim2.new(0, 10, 0, 0) }
        )
        shake:Play()
    end
end

KBtn.MouseButton1Click:Connect(CheckKey)
KBox.FocusLost:Connect(function(enter)
    if enter then CheckKey() end
end)
