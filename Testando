            local cam = workspace.CurrentCamera
            local speed = 90
            local vel = Vector3.zero
            vel += cam.CFrame.RightVector * (flyMove.right - flyMove.left) * speed
            vel += cam.CFrame.LookVector * (flyMove.up - flyMove.down) * speed
            if flyBV then flyBV.Velocity = vel end
        end)
    end

