local kokusenActive = false
local LIMITE_DIST = 15
local ultimaPos = nil
local monitorConn = nil

local function iniciarMonitor()
    if monitorConn then return end
    ultimaPos = nil
    monitorConn = RunService.Heartbeat:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            ultimaPos = nil
            return
        end
        if not kokusenActive then
            ultimaPos = root.Position
            return
        end
        if ultimaPos then
            local dist = (root.Position - ultimaPos).Magnitude
            if dist > LIMITE_DIST then
                root.CFrame = CFrame.new(ultimaPos)
            end
        end
        ultimaPos = root.Position
    end)
end

local function pararMonitor()
    if monitorConn then
        monitorConn:Disconnect()
        monitorConn = nil
    end
    ultimaPos = nil
end

