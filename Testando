-- Função para criar os Toggles estilo Imagem 2
local function CreateToggle(text)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 40)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    ToggleFrame.Parent = ContentFrame
    
    local TFCorner = Instance.new("UICorner", ToggleFrame)
    TFCorner.CornerRadius = UDim.new(0, 8)

    -- Borda vermelha como na Imagem 2
    local TFStroke = Instance.new("UIStroke", ToggleFrame)
    TFStroke.Color = Color3.fromRGB(200, 50, 50) 
    TFStroke.Thickness = 1.5

    local TLabel = Instance.new("TextLabel")
    TLabel.Size = UDim2.new(0.7, 0, 1, 0)
    TLabel.Position = UDim2.new(0, 10, 0, 0)
    TLabel.BackgroundTransparency = 1
    TLabel.Text = text
    TLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TLabel.Font = Enum.Font.Gotham
    TLabel.TextSize = 14
    TLabel.TextXAlignment = Enum.TextXAlignment.Left
    TLabel.Parent = ToggleFrame

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 40, 0, 20)
    ToggleBtn.Position = UDim2.new(1, -50, 0.5, -10)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    ToggleBtn.Text = ""
    ToggleBtn.Parent = ToggleFrame
    
    local TBCorner = Instance.new("UICorner", ToggleBtn)
    TBCorner.CornerRadius = UDim.new(1, 0) -- Formato de pílula

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 16, 0, 16)
    Circle.Position = UDim2.new(0, 2, 0.5, -8)
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Circle.Parent = ToggleBtn
    
    local CC = Instance.new("UICorner", Circle)
    CC.CornerRadius = UDim.new(1, 0)

    local toggled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 100, 255) -- Roxo quando ligado
            Circle.Position = UDim2.new(1, -18, 0.5, -8)
            -- ADICIONE A FUNÇÃO DO HACK AQUI SE QUISER
        else
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            Circle.Position = UDim2.new(0, 2, 0.5, -8)
            -- DESLIGAR HACK AQUI
        end
    end)
end

