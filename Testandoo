    local LIMITE_DIST = 15
    local ultimaPos = nil
    local monitorConn = nil

    local function iniciarMonitor()
        if monitorConn then return end
        ultimaPos = nil
        monitorConn = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then ultimaPos = nil return end
            if not kokusenActive then ultimaPos = root.Position return end
            if ultimaPos and (root.Position - ultimaPos).Magnitude > LIMITE_DIST then
                root.CFrame = CFrame.new(ultimaPos)
            end
            ultimaPos = root.Position
        end)
    end

    local function pararMonitor()
        if monitorConn then monitorConn:Disconnect() monitorConn = nil end
        ultimaPos = nil
    end

    kokusenBtn.MouseButton1Click:Connect(function()
        kokusenActive = not kokusenActive
        kokusenSet(kokusenActive)
        if kokusenActive then
            iniciarMonitor()
            task.spawn(function()
                pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/Nexo455/AutoBfc/refs/heads/main/Jujutsu%20shenanigans"))()
                end)
            end)
        else
            pararMonitor()
        end
    end)

    local espActive = false
    local espFolder = Instance.new("Folder", ScreenGui)
    espFolder.Name = "AetherESP"
    local espBtn, espSet = makeButton(pVisual, "ESP", 1)
    espBtn.MouseButton1Click:Connect(function()
        espActive = not espActive
        espSet(espActive)
        if espActive then
            task.spawn(function()
                while espActive do
                    espFolder:ClearAllChildren()
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local h = Instance.new("Highlight", espFolder)
                            h.Adornee = p.Character
                            h.FillColor = COR_BRIGHT
                            h.OutlineColor = Color3.fromRGB(255, 255, 255)
                            h.FillTransparency = 0.5
                        end
                    end
                    task.wait(1)
                end
                espFolder:ClearAllChildren()
            end)
        else
            espFolder:ClearAllChildren()
        end
    end)

    local fpsActive = false
    local fpsBtn, fpsSet = makeButton(pVisual, "FPS Booster", 2)
    fpsBtn.MouseButton1Click:Connect(function()
        fpsActive = not fpsActive
        fpsSet(fpsActive)
        if fpsActive then
            task.spawn(function()
                for _, v in ipairs(game:GetDescendants()) do
                    pcall(function()
                        if v:IsA("BasePart") then
                            v.Material = Enum.Material.SmoothPlastic
                            v.CastShadow = false
                        elseif v:IsA("Decal") or v:IsA("Texture") then
                            v:Destroy()
                        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                            v.Enabled = false
                        end
                    end)
                end
                workspace.GlobalShadows = false
            end)
        else
            workspace.GlobalShadows = true
        end
    end)

    -- FECHAR / CRIAR BOTÃO FLUTUANTE
    local floatBtn = nil

    local function criarBotaoFlutuante()
        if floatBtn then floatBtn:Destroy() end
        local fg = Instance.new("ScreenGui")
        fg.Name = "AetherFloatBtn"
        fg.ResetOnSpawn = false
        fg.IgnoreGuiInset = true
        fg.DisplayOrder = 999999
        fg.Parent = CoreGui

        local b = Instance.new("TextButton", fg)
        b.Size = UDim2.new(0, 50, 0, 50)
        b.Position = UDim2.new(0, 15, 0.5, -25)
        b.BackgroundColor3 = Color3.fromRGB(60, 30, 100)
        b.BorderSizePixel = 0
        b.Text = "A"
        b.TextColor3 = COR_BRIGHT
        b.Font = Enum.Font.GothamBold
        b.TextSize = 22
        b.AutoButtonColor = false
        b.Draggable = true
        b.ZIndex = 100
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

        local s = Instance.new("UIStroke", b)
        s.Color = COR_MAIN
        s.Thickness = 2
        s.Transparency = 0.1

        b.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(b, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 50, 0, 50),
        }):Play()

        task.spawn(function()
            while b.Parent do
                for i = 0, 1, 0.08 do
                    if not b.Parent then break end
                    s.Transparency = 0.1 + math.abs(math.sin(i * math.pi)) * 0.5
                    task.wait(0.03)
                end
            end
        end)

        b.MouseButton1Click:Connect(function()
            MainFrame.Visible = true
            MainFrame.Size = UDim2.new(0, 0, 0, 0)
            MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = NORMAL_SIZE,
                Position = NORMAL_POS,
            }):Play()
            b:Destroy()
            floatBtn = nil
        end)

        floatBtn = b
    end

    MinButton.MouseButton1Click:Connect(function()
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
        }):Play()
        task.wait(0.3)
        MainFrame.Visible = false
        criarBotaoFlutuante()
    end)
