-- ==================== BOTÃO 4: FOCUS / AUTO ORBIT (SEM DUMMY) ====================
local focusActive = false
local focusTarget = nil
local orbitAngle = 0
local ORBIT_DIST = 6
local ORBIT_SPEED = 5

local FocusBtn, focusStroke = createNeonButton("Focus / Auto Orbit [OFF]")

local function getClosestRealPlayer()
    local closest, shortestDist = nil, math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local charName = p.Character.Name:lower()
            if not string.find(charName, "dummy") and not string.find(charName, "npc") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp then
                    local dist = (myChar.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

FocusBtn.MouseButton1Click:Connect(function()
    focusActive = not focusActive
    FocusBtn.Text = focusActive and "Focus / Auto Orbit [ON]" or "Focus / Auto Orbit [OFF]"
    FocusBtn.BackgroundColor3 = focusActive and BUTTON_ON or BUTTON_OFF
    focusStroke.Color = focusActive and Color3.fromRGB(255, 180, 255) or ACCENT_NEON
    if not focusActive then focusTarget = nil end
end)

RunService.RenderStepped:Connect(function(dt)
    if not focusActive then return end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    if not focusTarget or not focusTarget.Character or not focusTarget.Character:FindFirstChild("HumanoidRootPart") then
        focusTarget = getClosestRealPlayer()
    end

    if focusTarget and focusTarget.Character then
        local tHrp = focusTarget.Character:FindFirstChild("HumanoidRootPart")
        local tHum = focusTarget.Character:FindFirstChildOfClass("Humanoid")

        if tHum and tHum.Health > 0 and tHrp then
            orbitAngle = orbitAngle + (dt * ORBIT_SPEED)
            local offset = Vector3.new(math.cos(orbitAngle) * ORBIT_DIST, 1, math.sin(orbitAngle) * ORBIT_DIST)
            myHrp.CFrame = CFrame.new(tHrp.Position + offset, tHrp.Position)

            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(0, 0))
            task.wait(0.02)
            VirtualUser:Button1Up(Vector2.new(0, 0))
        else
            focusTarget = nil
        end
    end
end)

