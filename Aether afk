-- Função pra atualizar o painel
local function setStatus(texto, subtexto, cor)
    if not statusLabel then return end
    currentStatus = texto
    statusLabel.Text = "• " .. texto
    statusLabel.TextColor3 = cor or Color3.fromRGB(220, 200, 255)
    if statusDot then statusDot.BackgroundColor3 = cor or Color3.fromRGB(200, 150, 255) end
    if subtexto then
        local painel = statusLabel.Parent
        local sub = painel:FindFirstChildOfClass("TextLabel", true)
        -- atualiza o sublabel
        for _, c in ipairs(painel:GetChildren()) do
            if c:IsA("TextLabel") and c ~= statusLabel and c.TextSize == 11 then
                c.Text = subtexto
            end
        end
    end
end

