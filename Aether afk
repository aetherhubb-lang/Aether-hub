local gojoActive = false
local gojoConn   = nil
local gojoIdx    = 1

local function startGojo02(duration)
    local CANTO = Vector3.new(2000, 100, 2000)
    setStatus("Gojo 0.2", "🏃 indo pro canto...", Color3.fromRGB(255, 220, 100))

    local myRoot = getMyRoot()
    local myHum  = getMyHum()
    if myRoot and myHum then
        myHum.PlatformStand = true
        for i = 1, 5 do
            myRoot.CFrame = CFrame.new(CANTO)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.05)
        end
    end

    setStatus("Gojo 0.2", "⚔️ ativando G + R...", Color3.fromRGB(255, 220, 100))
    task.wait(0.5)

    VirtualUser:SendKeyEvent(true,  Enum.KeyCode.G, false, game)
    task.wait(0.05)
    VirtualUser:SendKeyEvent(false, Enum.KeyCode.G, false, game)
    task.wait(0.1)
    VirtualUser:SendKeyEvent(true,  Enum.KeyCode.R, false, game)
    task.wait(0.05)
    VirtualUser:SendKeyEvent(false, Enum.KeyCode.R, false, game)
    task.wait(1)

    local lista = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr  = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if tr and hum and hum.Health > 0 then
                table.insert(lista, tr)
            end
        end
    end

    if #lista == 0 then
        setStatus("Gojo 0.2", "⚠️ sem players", Color3.fromRGB(220, 80, 100))
        task.wait(2)
        return
    end

    gojoActive = true
    gojoIdx = 1
    gojoConn = RunService.PreSimulation:Connect(function()
        if not gojoActive then return end
        if #lista == 0 then return end
        if gojoIdx > #lista then gojoIdx = 1 end
        local alvo = lista[gojoIdx]
        if alvo and alvo.Parent then
            local mr = getMyRoot()
            if mr then mr.CFrame = alvo.CFrame end
        end
        gojoIdx += 1
    end)

    local endTime = tick() + duration
    while tick() < endTime do
        setStatus("Gojo 0.2", "⚔️ " .. math.floor(endTime - tick()) .. "s", Color3.fromRGB(255, 220, 100))
        task.wait(1)
    end

    gojoActive = false
    if gojoConn then gojoConn:Disconnect() gojoConn = nil end
    setStatus("Gojo 0.2", "✅ finalizado", Color3.fromRGB(120, 255, 180))

    local h = getMyHum()
    if h then
        h.PlatformStand = false
        h.AutoRotate = true
    end
end

