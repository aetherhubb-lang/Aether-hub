-- 2) ACHAR DUMMY
--═══════════════════════════════════════════════════════
local function acharDummy()
    local myChar = LP.Character
    local myRoot = getMyRoot()
    if not myRoot then return nil end

    local melhor, distMin = nil, math.huge

    local function isPlayer(model)
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character == model then return true end
        end
        return false
    end

    local pastas = {workspace}
    for _, nome in ipairs({"Characters","Dummies","NPCs","Enemies","TrainingDummies"}) do
        local p = workspace:FindFirstChild(nome)
        if p then table.insert(pastas, p) end
    end

    for _, pasta in ipairs(pastas) do
        for _, obj in ipairs(pasta:GetChildren()) do
            if obj:IsA("Model") and obj ~= myChar and not isPlayer(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local root = obj:FindFirstChild("HumanoidRootPart")
                        or obj:FindFirstChild("Torso")
                        or obj:FindFirstChild("UpperTorso")
                    if root then
                        local d = (root.Position - myRoot.Position).Magnitude
                        if d < distMin then
                            distMin = d
                            melhor = {root=root, hum=hum, model=obj}
                        end
                    end
                end
            end
        end
    end
    return melhor
end

