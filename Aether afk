-- 1) BYPASS
--═══════════════════════════════════════════════════════
local function ExecutarBypass()
    local char = LP.Character or LP.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return false end

    local sucesso = false
    pcall(function()
        local jogadores = Players:GetPlayers()
        for i = #jogadores, 1, -1 do
            if jogadores[i] == LP then table.remove(jogadores, i) end
        end
        if #jogadores > 0 then
            local alvo = jogadores[math.random(1, #jogadores)]
            if alvo and alvo.Character
               and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                root.CFrame = CFrame.new(posAlvo)
                task.wait(0.5)
                if root and root.Parent
                   and (root.Position - posAlvo).Magnitude < 25 then
                    sucesso = true
                end
            end
        end
    end)
    return sucesso
end

local function rotaDoVoid()
    pcall(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9999999, 9999999, 9999999)
        bv.Velocity = Vector3.new(0, 100, 0)
        bv.Parent = root
        task.wait(1.5)
        bv.Velocity = Vector3.new(-700, 0, 0)
        task.wait(2)
        bv.Velocity = Vector3.zero
        hum.PlatformStand = false
        bv:Destroy()
    end)
end

local function bypass()
    setStatus("Auto Bypass", "tentando...", Color3.fromRGB(255, 180, 100))
    local tentativas = 0
    while true do
        tentativas += 1
        setStatus("Auto Bypass", "tentativa #" .. tentativas, Color3.fromRGB(255, 180, 100))
        local ok = ExecutarBypass()
        if ok then
            setStatus("Bypass Ativado", "✅ concluído (#"..tentativas..")", Color3.fromRGB(60, 220, 120))
            task.wait(1)
            return true
        else
            setStatus("Auto Bypass", "❌ falhou, resetando...", Color3.fromRGB(220, 80, 100))
            rotaDoVoid()
            task.wait(5)
        end
    end
end

