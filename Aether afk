-- 3) VERIFICA ULT CHEIA
--═══════════════════════════════════════════════════════
local function ultCheia()
    local u = LP:GetAttribute("Ultimate") or LP:GetAttribute("Ult") or LP:GetAttribute("Awakening")
    if u and typeof(u) == "number" and u >= 100 then return true end

    local uo = LP:FindFirstChild("Ultimate") or LP:FindFirstChild("UltBar")
    if uo and uo:IsA("NumberValue") and uo.Value >= 100 then return true end

    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, s in ipairs(pg:GetChildren()) do
            if s:IsA("ScreenGui") and s.Enabled then
                for _, o in ipairs(s:GetDescendants()) do
                    if o:IsA("TextLabel") then
                        local n  = (o.Name or ""):lower()
                        local pn = (o.Parent and o.Parent.Name or ""):lower()
                        if (n:find("ult") or pn:find("ult")) and
                           (o.Text:find("100") or o.Text:find("MAX")) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end--═══════════════════════════════════════════════════════
-- 4) FOCUS ORBITANDO (BODYVELOCITY - FIX JJS)
--═══════════════════════════════════════════════════════
local function farmUlt()
    setStatus("Iniciando Focus", "procurando dummy...", Color3.fromRGB(200, 150, 255))

    local lastClick = 0
    local lastSkill = 0
    local skillIdx = 1
    local angle = 0
    local SKILLS    = { Enum.KeyCode.Four, Enum.KeyCode.Two, Enum.KeyCode.Three }
    local SKILL_NUM = { 4, 2, 3 }

    local RADIUS = 6
    local HEIGHT = 3

    local currentTarget = nil
    local lastHP = 0

    local function targetValido(t)
        if not t then return false end
        if not t.hum or not t.hum.Parent then return false end
        if not t.root or not t.root.Parent then return false end
        return true
    end

    local function limparFisica()
        local mr = getMyRoot()
        if not mr then return end
        for _, v in ipairs(mr:GetChildren()) do
            if v.Name == "AetherVel" or v.Name == "AetherGyro" then
                v:Destroy()
            end
        end
    end

    local function acharAlvo()
        currentTarget = nil
        setStatus("Procurando Dummy", "🔄 procurando...", Color3.fromRGB(255, 180, 100))

        while not currentTarget do
            if ultCheia() then return true end
            currentTarget = acharDummy()
            if not currentTarget then
                task.wait(0.3)
            end
        end
        lastHP = currentTarget.hum.Health
        angle = 0
        setStatus("Focus no Dummy", "✅ alvo encontrado!", Color3.fromRGB(60, 220, 120))
        return false
    end

    while true do
        if ultCheia() then
            limparFisica()
            setStatus("Ult Completa!", "preparando Gojo...", Color3.fromRGB(120, 255, 180))
            return true
        end

        local precisaTrocar = false
        if not targetValido(currentTarget) then
            precisaTrocar = true
        elseif currentTarget.hum.Health <= 0 then
            precisaTrocar = true
        elseif currentTarget.hum.Health > lastHP + 20 then
            precisaTrocar = true
        end

        if precisaTrocar then
            limparFisica()
            if acharAlvo() then return true end
        end

        if not currentTarget then
            task.wait(0.2)
            continue
        end

        lastHP = currentTarget.hum.Health

        local mr = getMyRoot()
        local mh = getMyHum()
        if not mr or not mh then
            task.wait(0.1)
            continue
        end

        -- 🔥 Cria BodyVelocity + BodyGyro
        local vel = mr:FindFirstChild("AetherVel")
        if not vel then
            vel = Instance.new("BodyVelocity")
            vel.Name = "AetherVel"
            vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            vel.P = 10000
            vel.Parent = mr
        end

        local gyro = mr:FindFirstChild("AetherGyro")
        if not gyro then
            gyro = Instance.new("BodyGyro")
            gyro.Name = "AetherGyro"
            gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            gyro.P = 10000
            gyro.Parent = mr
        end

        -- 🌀 Próximo ponto da órbita
        angle += 0.08
        local dummyPos = currentTarget.root.Position
        local offset = Vector3.new(
            math.cos(angle) * RADIUS,
            HEIGHT,
            math.sin(angle) * RADIUS
        )
        local target = dummyPos + offset

        -- 💨 Empurra pro alvo
        local dir = (target - mr.Position)
        vel.Velocity = dir * 10

        -- 🎯 Encara o dummy
        gyro.CFrame = CFrame.new(mr.Position, Vector3.new(dummyPos.X, mr.Position.Y, dummyPos.Z))

        -- 🖱️ M1
        if tick() - lastClick > 0.15 then
            lastClick = tick()

            task.spawn(function()
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0, 0))
                end)
            end)
            task.spawn(function()
                pcall(function()
                    VirtualUser:Button1Down(Vector2.new(0, 0))
                    task.wait(0.05)
                    VirtualUser:Button1Up(Vector2.new(0, 0))
                end)
            end)
            task.spawn(function()
                pcall(function()
                    VirtualUser:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
                    task.wait(0.05)
                    VirtualUser:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end)
            end)
        end

        -- ⚡ Skills 4, 2, 3
        if tick() - lastSkill > 1.2 then
            lastSkill = tick()
            local key = SKILLS[skillIdx]

            task.spawn(function()
                pcall(function()
                    VirtualUser:SendKeyEvent(true,  key, false, game)
                    task.wait(0.08)
                    VirtualUser:SendKeyEvent(false, key, false, game)
                end)
            end)

            skillIdx = skillIdx + 1
            if skillIdx > #SKILLS then skillIdx = 1 end
        end

        local d = (mr.Position - dummyPos).Magnitude
        setStatus("Focus + M1 + Skills",
            string.format("HP: %d | dist: %dm | skill: %d",
                math.floor(currentTarget.hum.Health),
                math.floor(d),
                SKILL_NUM[skillIdx == 1 and 4 or (skillIdx == 2 and 2 or 3)]),
            Color3.fromRGB(200, 150, 255))

        task.wait(0.03)
    end
end

