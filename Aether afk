    clickMouse()
    task.wait(0.1)
end

local function executarCombo()
    print("🎬 Iniciando combo (JJS)...")

    -- 1. Focus no dummy
    if not focusAtivo then
        iniciarFocus("dummy")
    end

    -- 2. Farmar ult batendo no dummy
    local tempoInicio = tick()
    while comboAtivo and not ultEstaCheia() do
        if (tick() - tempoInicio) > T_ULT_TIMEOUT then
            print("⚠️ Timeout aguardando ult, continuando...")
            break
        end
        baterNoDummy()
        task.wait(0.1)
    end

    if not comboAtivo then return end
    atualizarStatus("Ult", "CHEIA")
    print("✨ Ult cheia!")

    -- 3. Para Focus
    pararFocus()

    -- 4. Vai pro canto do mapa
    irParaCanto()
    task.wait(0.5)

    -- 5. Ativa ult (G)
    pressKey(TECLA_ULT, 0.1)
    task.wait(T_POS_ULT)

    -- 6. Gojo 0.2 (G + R)
    print("🌀 Ativando Gojo 0.2 (G + R)...")
    pressKey(TECLA_ULT, 0.1)
    task.wait(0.2)
    pressKey(TECLA_0_2, 0.1)

    -- 7. Espera 3 segundos
    task.wait(T_POS_02)

    -- 8. Ativa Gojo Kill All
    print("💥 Ativando Gojo Kill All...")
    if not gojoAtivo then iniciarGojo() end

    -- 9. Espera 15 segundos
    task.wait(T_POS_KILL)

    -- 10. Server hop
    if comboAtivo then
        print("🚪 Server hop...")
        serverHop()
    end
end

local function iniciarCombo()
    if comboAtivo then return end
    comboAtivo = true
    atualizarStatus("Combo", true)
    atualizarStatus("Ult", "0%")
    if not bypassAtivo then iniciarBypass() end
    comboThread = task.spawn(executarCombo)
end

local function pararCombo()
    if not comboAtivo then return end
    comboAtivo = false
    atualizarStatus("Combo", false)
    if comboThread then task.cancel(comboThread); comboThread = nil end
    pararFocus()
    pararGojo()
end

-- Monitor de ult
task.spawn(function()
    while true do
        if comboAtivo and not ultEstaCheia() then
            atualizarStatus("Ult", "...")
        end
        task.wait(0.5)
    end
end)-- ============================================================
