local function getMyRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getMyHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end--═══════════════════════════════════════════════════════
-- 1) BYPASS
--═══════════════════════════════════════════════════════
local function bypass()
    setStatus("Auto Bypass", "teleportando p/ player...", Color3.fromRGB(255, 180, 100))
    print("[AFK] 🔥 Bypass...")

    local char = LP.Character or LP.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return false end

    local sucesso = false
    pcall(function()
        local lista = Players:GetPlayers()
        for i = #lista, 1, -1 do
            if lista[i] == LP then table.remove(lista, i) end
        end
        if #lista > 0 then
            local alvo = lista[math.random(1, #lista)]
            if alvo.Character then
                local tr = alvo.Character:FindFirstChild("HumanoidRootPart")
                if tr then
                    root.CFrame = CFrame.new(tr.Position + Vector3.new(0, 3, 0))
                    task.wait(0.5)
                    if (root.Position - tr.Position).Magnitude < 25 then
                        sucesso = true
                    end
                end
            end
        end
    end)

    if sucesso then
        setStatus("Auto Bypass", "✅ concluído", Color3.fromRGB(60, 220, 120))
    else
        setStatus("Auto Bypass", "⚠️ falhou (sem players)", Color3.fromRGB(220, 80, 100))
    end
    task.wait(0.5)
    return sucesso
end

