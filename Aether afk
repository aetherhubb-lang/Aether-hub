-- ==================== DETECÇÃO DE DUMMY ====================
local dummyAtual = nil
local dummyAnterior = nil

local function encontrarDummy()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local n = obj.Name:lower()
            if n:find("dummy") or n:find("boneco") or n:find("alvo") 
               or n:find("target") or n:find("low hp") 
               or n:find("immortal") or n:find("attacking") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp then return obj, hum end
            end
        end
    end
    return nil, nil
end

local function monitorarDummy()
    task.spawn(function()
        while true do
            local d, hum = encontrarDummy()
            dummyAtual = d
            if d and hum then
                local vivo = hum.Health > 0
                if vivo ~= dummyAnterior then
                    dummyAnterior = vivo
                    atualizarStatus("Dummy", vivo and "vivo" or "morto")
                end
            else
                if dummyAnterior ~= "sem" then
                    dummyAnterior = "sem"
                    atualizarStatus("Dummy", "n/a")
                end
            end
            task.wait(0.5)
        end
    end)
end
monitorarDummy()

-- ==================== BYPASS ====================
local bypassAtivo = false
local bypassThread = nil

local function AtualizarChar()
    local char = LP.Character or LP.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart", 5), char:WaitForChild("Humanoid", 5)
end

local function ExecutarBypass()
    local char, root = AtualizarChar()
    if not root then return false end
    local ok = false
    pcall(function()
        local js = Players:GetPlayers()
        for i = #js, 1, -1 do
            if js[i] == LP then table.remove(js, i) end
        end
        if #js > 0 then
            local alvo = js[math.random(1, #js)]
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local pos = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                root.CFrame = CFrame.new(pos)
                task.wait(0.5)
                if root and root.Parent and (root.Position - pos).Magnitude < 25 then
                    ok = true
                end
            end
        end
    end)
    return ok
end

local function rotaDoVoid()
    local char, root, hum = AtualizarChar()
    if not root or not hum then return end
    pcall(function()
        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9999999, 9999999, 9999999)
        bv.Velocity = Vector3.new(0, 100, 0)
        bv.Parent = root
        task.wait(1.5)
        bv.Velocity = Vector3.new(-700, 0, 0)
        task.wait(2)
        bv.Velocity = Vector3.zero
        hum.PlatformStand = false
        bv:Destroy()
    end)
end

local function iniciarBypass()
    if bypassAtivo then return end
    bypassAtivo = true
    atualizarStatus("Bypass", true)
    bypassThread = task.spawn(function()
        local t = 0
        while bypassAtivo do
            t += 1
            print("💀 Bypass tentativa #" .. t)
            local ok = ExecutarBypass()
            if ok then
                print("✅ Bypass FUNCIONOU #" .. t)
                break
            else
                print("❌ Falhou #" .. t)
                rotaDoVoid()
                task.wait(3)
            end
        end
        if bypassAtivo then
            bypassAtivo = false
            atualizarStatus("Bypass", false)
        end
    end)
end

local function pararBypass()
    if not bypassAtivo then return end
    bypassAtivo = false
    atualizarStatus("Bypass", false)
    if bypassThread then task.cancel(bypassThread); bypassThread = nil end
end

-- ==================== FOCUS ====================
local focusAtivo = false
local focusThread = nil
local focusModo = "player"

local function iniciarFocus(modo)
    if focusAtivo then return end
    focusAtivo = true
    focusModo = modo or "player"
    atualizarStatus("Focus", true)

    focusThread = task.spawn(function()
        while focusAtivo do
            local char = LP.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local alvo = nil
                    if focusModo == "dummy" and dummyAtual then
                        local dummyHrp = dummyAtual:FindFirstChild("HumanoidRootPart")
                        if dummyHrp then alvo = dummyHrp end
                    end
                    if not alvo then
                        local distMin = math.huge
                        for _, j in ipairs(Players:GetPlayers()) do
                            if j ~= LP and j.Character then
                                local h = j.Character:FindFirstChild("HumanoidRootPart")
                                local hu = j.Character:FindFirstChildOfClass("Humanoid")
                                if h and hu and hu.Health > 0 then
                                    local d = (hrp.Position - h.Position).Magnitude
                                    if d < distMin then distMin = d; alvo = h end
                                end
                            end
                        end
                    end
                    if alvo then
                        local ang = tick() * 10
                        local raio = 3
                        local offset = Vector3.new(math.cos(ang) * raio, 3, math.sin(ang) * raio)
                        pcall(function()
                            hrp.CFrame = CFrame.new(alvo.Position + offset, alvo.Position)
                        end)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end

local function pararFocus()
    if not focusAtivo then return end
    focusAtivo = false
    atualizarStatus("Focus", false)
    if focusThread then task.cancel(focusThread); focusThread = nil end
end

-- ==================== GOJO KILL ALL ====================
local gojoAtivo = false
local gojoThread = nil

local function iniciarGojo()
    if gojoAtivo then return end
    gojoAtivo = true
    atualizarStatus("Gojo", true)

    gojoThread = task.spawn(function()
        while gojoAtivo do
            local char = LP.Character
            if not char then LP.CharacterAdded:Wait(); char = LP.Character end
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.5); continue end

            local alvos = {}
            for _, j in ipairs(Players:GetPlayers()) do
                if j ~= LP and j.Character then
                    local h = j.Character:FindFirstChild("HumanoidRootPart")
                    local hu = j.Character:FindFirstChildOfClass("Humanoid")
                    if h and hu and hu.Health > 0 then table.insert(alvos, h) end
                end
            end

            if #alvos > 0 then
                for _, h in ipairs(alvos) do
                    if not gojoAtivo then break end
                    pcall(function()
                        hrp.CFrame = CFrame.new(h.Position + Vector3.new(0, 3, 0))
                    end)
                    task.wait(0.05)
                end
            else
                task.wait(0.2)
            end
        end
    end)
end

local function pararGojo()
    if not gojoAtivo then return end
    gojoAtivo = false
    atualizarStatus("Gojo", false)
    if gojoThread then task.cancel(gojoThread); gojoThread = nil end
end

