local function pressKey(keyCode, holdTime)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(holdTime or 0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function clickMouse()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

-- ==================== DETECÇÃO DE ULT ====================
local function ultEstaCheia()
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            local nome = obj.Name:lower()
            if nome:find("awaken") or nome:find("ultimate") 
               or nome:find("special") or nome:find("meter") then
                if obj:IsA("Frame") and obj.Size.X.Scale >= 0.98 then
                    return true
                end
            end
        end
    end
    for _, obj in ipairs(LP:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("FloatValue") then
            local nome = obj.Name:lower()
            if nome:find("awaken") or nome:find("ultimate") 
               or nome:find("special") or nome:find("meter") then
                if obj.Value >= 100 then return true end
            end
        end
    end
    return false
end

-- ==================== SERVER HOP ====================
local function serverHop()
    local ok = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                    "/servers/Public?sortOrder=Asc&limit=100"
        local resp = game:HttpGet(url)
        local data = HttpService:JSONDecode(resp)
        for _, srv in ipairs(data.data) do
            if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LP)
                return
            end
        end
    end)
    if not ok then
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LP)
        end)
    end
end-- ============================================================
