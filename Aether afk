-- ⚔️ GOJO 0.2 LOOP
--═══════════════════════════════════════════════════════
local function rodar02(duracao)
    local endTime = tick() + duracao
    local idx = 1
    local lista = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr  = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if tr and hum and hum.Health > 0 then
                table.insert(lista, tr)
            end
        end
    end

    if #lista == 0 then
        return
    end

    task.spawn(function()
        task.wait(0.3)
        VirtualUser:SendKeyEvent(true, Enum.KeyCode.G, false, game)
        task.wait(0.05)
        VirtualUser:SendKeyEvent(false, Enum.KeyCode.G, false, game)
        task.wait(0.1)
        VirtualUser:SendKeyEvent(true, Enum.KeyCode.R, false, game)
        task.wait(0.05)
        VirtualUser:SendKeyEvent(false, Enum.KeyCode.R, false, game)
    end)

    while tick() < endTime do
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and #lista > 0 then
            if idx > #lista then idx = 1 end
            local alvo = lista[idx]
            if alvo and alvo.Parent then
                root.CFrame = alvo.CFrame
            end
            idx += 1
        end
        RunService.Heartbeat:Wait()
    end
end

