-- 3) VERIFICA ULT CHEIA
--═══════════════════════════════════════════════════════
local function ultCheia()
    local u = LP:GetAttribute("Ultimate") or LP:GetAttribute("Ult") or LP:GetAttribute("Awakening")
    if u and typeof(u) == "number" and u >= 100 then return true end

    local uo = LP:FindFirstChild("Ultimate") or LP:FindFirstChild("UltBar")
    if uo and uo:IsA("NumberValue") and uo.Value >= 100 then return true end

    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, s in ipairs(pg:GetChildren()) do
            if s:IsA("ScreenGui") and s.Enabled then
                for _, o in ipairs(s:GetDescendants()) do
                    if o:IsA("TextLabel") then
                        local n  = (o.Name or ""):lower()
                        local pn = (o.Parent and o.Parent.Name or ""):lower()
                        if (n:find("ult") or pn:find("ult")) and
                           (o.Text:find("100") or o.Text:find("MAX")) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end--═══════════════════════════════════════════════════════
-- 4) FARM ULT NO DUMMY
--═══════════════════════════════════════════════════════
local function farmUlt()
    setStatus("Focus no Dummy", "farmando ult...", Color3.fromRGB(200, 150, 255))
    print("[AFK] 🎯 Farmando ult...")

    local total = 0
    local lastClick = 0

    while true do
        if ultCheia() then
            setStatus("Ult Completa!", "preparando ativação...", Color3.fromRGB(120, 255, 180))
            return true
        end

        local dummy = acharDummy()
        if not dummy then
            setStatus("Focus no Dummy", "⏳ procurando dummy...", Color3.fromRGB(255, 180, 100))
            task.wait(1)
            continue
        end

        local myRoot = getMyRoot()
        if not myRoot then task.wait(0.3) continue end

        if (myRoot.Position - dummy.root.Position).Magnitude > 15 then
            myRoot.CFrame = dummy.root.CFrame * CFrame.new(0, 3, -5)
            task.wait(0.1)
        end

        while dummy.hum and dummy.hum.Health > 0
              and dummy.root and dummy.root.Parent do

            if ultCheia() then
                setStatus("Ult Completa!", "preparando ativação...", Color3.fromRGB(120, 255, 180))
                return true
            end

            local mr = getMyRoot()
            if not mr then break end

            total += 8 * RunService.Heartbeat:Wait()
            local vx = math.cos(total) * 5
            local vz = math.sin(total) * 5
            mr.CFrame = CFrame.lookAt(
                dummy.root.Position + Vector3.new(vx, 1, vz),
                dummy.root.Position
            )

            if tick() - lastClick > 0.2
               and (mr.Position - dummy.root.Position).Magnitude < 15 then
                lastClick = tick()
                task.spawn(function()
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new())
                    end)
                end)
            end

            -- Atualiza status com info do dummy
            setStatus("Focus no Dummy",
                string.format("HP: %d | dist: %dm",
                    math.floor(dummy.hum.Health),
                    math.floor((mr.Position - dummy.root.Position).Magnitude)),
                Color3.fromRGB(200, 150, 255))
        end
    end
end

