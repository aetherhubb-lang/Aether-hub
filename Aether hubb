local focusActive = false
local focusBtn = makeButton("Focus: OFF", 4)
local focusConn, focusTarget

local function findNearest()
    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if tr and hum and hum.Health > 0 then
                local d = (tr.Position - r.Position).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

local function stopFocus()
    if focusConn then focusConn:Disconnect(); focusConn = nil end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    focusTarget = nil
end

local function startFocus()
    focusTarget = findNearest()
    if not focusTarget then
        focusActive = false
        focusBtn.Text = "Focus: OFF"
        return
    end

    local angle = 0
    local radius = 6
    local speed = 5
    local heightOffset = 3

    focusConn = RunService.Heartbeat:Connect(function(dt)
        if not focusActive then return end

        if not focusTarget or not focusTarget.Character
           or not focusTarget.Character.Parent then
            focusTarget = findNearest()
            if not focusTarget then return end
        end

        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local tr   = focusTarget.Character:FindFirstChild("HumanoidRootPart")
        local tHum = focusTarget.Character:FindFirstChildOfClass("Humanoid")

        if not root or not hum or not tr then return end
        if tHum and tHum.Health <= 0 then
            focusTarget = findNearest()
            return
        end

        hum.PlatformStand = true

        angle += dt * speed
        local offset = Vector3.new(math.cos(angle) * radius, heightOffset, math.sin(angle) * radius)
        local newPos = tr.Position + offset

        root.CFrame = CFrame.new(newPos, tr.Position)
        root.Velocity = Vector3.zero
    end)
end

focusBtn.MouseButton1Click:Connect(function()
    focusActive = not focusActive
    focusBtn.Text = "Focus: " .. (focusActive and "ON" or "OFF")
    if focusActive then startFocus() else stopFocus() end
end)

