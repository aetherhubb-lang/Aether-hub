    status.Position = UDim2.new(0, 0, 0, 200)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(220, 80, 100)
    status.Font = Enum.Font.Gotham
    status.TextSize = 13
    status.Parent = frame

    local verified = false
    local function tryVerify()
        if verified then return end
        if box.Text == KEY then
            verified = true
            status.Text = "✔ Acesso Concedido"
            status.TextColor3 = Color3.fromRGB(60, 200, 100)
            task.wait(0.7)
            gui:Destroy()
            _G.AetherAuthenticated = true
            loadMainHub()
        else
            status.Text = "✘ Key inválida"
            box.Text = ""
        end
    end

    btn.MouseButton1Click:Connect(tryVerify)
    box.FocusLost:Connect(function(enter)
        if enter then tryVerify() end
    end)
end

