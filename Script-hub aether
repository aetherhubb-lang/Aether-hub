    gui.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 340, 0, 230)
    frame.Position = UDim2.new(0.5, -170, 0.5, -115)
    frame.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 16); c.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(190, 150, 255)
    stroke.Thickness = 2
    stroke.Transparency = 0.1
    stroke.Parent = frame

