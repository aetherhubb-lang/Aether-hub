    local bs = Instance.new("UIStroke")
    bs.Color = Color3.fromRGB(180, 130, 255); bs.Thickness = 1.5; bs.Transparency = 0.3
    bs.Parent = box

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 260, 0, 40)
    btn.Position = UDim2.new(0.5, -130, 0, 150)
    btn.BackgroundColor3 = Color3.fromRGB(140, 80, 230)
    btn.BorderSizePixel = 0
    btn.Text = "Verificar"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
