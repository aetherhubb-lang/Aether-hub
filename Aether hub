        createFly()
        startFly()
    else
        flyS.Color = Color3.fromRGB(90, 50, 140)
        flyS.Transparency = 0.3
        if flyG then flyG:Destroy() flyG = nil end
        stopFly()
    end
end)

-- BYPASS
local bypassOn = false
local bypassB, bypassL, bypassS = mkBtn("Bypass: OFF", 3)
local function ExecutarBypass()
    local ch = LP.Character or LP.CharacterAdded:Wait()
    local rt = ch:WaitForChild("HumanoidRootPart", 5)
    if not rt then return false end
    local ok = false
    pcall(function()
        local jog = Players:GetPlayers()
        for i = #jog, 1, -1 do
            if jog[i] == LP then table.remove(jog, i) end
        end
        if #jog > 0 then
            local alvo = jog[math.random(1, #jog)]
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local pos = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                rt.CFrame = CFrame.new(pos)
                task.wait(0.5)
                if (rt.Position - pos).Magnitude < 25 then ok = true end
            end
        end
    end)
    return ok
end

local function rotaDoVoid()
    pcall(function()
        local ch = LP.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if not rt or not h then return end
        h.PlatformStand = true
        local bv = Instance.new("BodyVelocity", rt)
        bv.MaxForce = Vector3.new(9e6, 9e6, 9e6)
        bv.Velocity = Vector3.new(0, 150, 0)
        task.wait(1.3)
        bv.Velocity = Vector3.new(-300, 0, 0)
        task.wait(2.4)
        bv.Velocity = Vector3.zero
        h.PlatformStand = false
        bv:Destroy()
    end)
end

bypassB.MouseButton1Click:Connect(function()
    bypassOn = not bypassOn
    bypassL.Text = "Bypass: " .. (bypassOn and "ON" or "OFF")
    if bypassOn then
        bypassS.Color = R
        bypassS.Transparency = 0
        task.spawn(function()
            while bypassOn do
                if ExecutarBypass() then
                    bypassOn = false
                    bypassL.Text = "Bypass: OFF"
                    bypassS.Color = Color3.fromRGB(90, 50, 140)
                    bypassS.Transparency = 0.3
                    break
                else
