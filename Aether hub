FlyGui.Parent = ScreenGui

local flyMove = {fwd = 0, back = 0, left = 0, right = 0, up = 0, down = 0}

local function makeArrow(text, pos, size, parent)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    btn.Text = text
    btn.TextColor3 = TEXT_COLOR
    btn.TextSize = 20
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    addCorner(btn, 8)
    return btn
end

local LeftBox = Instance.new("Frame")
LeftBox.Size = UDim2.new(0, 130, 0, 130)
LeftBox.Position = UDim2.new(0, 20, 1, -150)
LeftBox.BackgroundTransparency = 1
LeftBox.Parent = FlyGui

local btnUp = makeArrow("▲", UDim2.new(0.35, 0, 0, 0), UDim2.new(0.3, 0, 0.3, 0), LeftBox)
local btnDown = makeArrow("▼", UDim2.new(0.35, 0, 0.7, 0), UDim2.new(0.3, 0, 0.3, 0), LeftBox)
local btnLeft = makeArrow("◀", UDim2.new(0, 0, 0.35, 0), UDim2.new(0.3, 0, 0.3, 0), LeftBox)
local btnRight = makeArrow("▶", UDim2.new(0.7, 0, 0.35, 0), UDim2.new(0.3, 0, 0.3, 0), LeftBox)

local RightBox = Instance.new("Frame")
RightBox.Size = UDim2.new(0, 50, 0, 110)
RightBox.Position = UDim2.new(1, -70, 1, -140)
RightBox.BackgroundTransparency = 1
RightBox.Parent = FlyGui

local btnAsc = makeArrow("⬆", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.45, 0), RightBox)
local btnDesc = makeArrow("⬇", UDim2.new(0, 0, 0.55, 0), UDim2.new(1, 0, 0.45, 0), RightBox)

local function bind(btn, k)
    btn.MouseButton1Down:Connect(function() flyMove[k] = 1 end)
    btn.MouseButton1Up:Connect(function() flyMove[k] = 0 end)
    btn.InputEnded:Connect(function() flyMove[k] = 0 end)
end

bind(btnUp, "fwd") bind(btnDown, "back") bind(btnLeft, "left") bind(btnRight, "right")
bind(btnAsc, "up") bind(btnDesc, "down")

local flyConn, bv, bg
local FlyBtn = Instance.new("TextButton")
FlyBtn.Size = UDim2.new(1, 0, 0, 45)
FlyBtn.BackgroundColor3 = BUTTON_OFF
FlyBtn.Text = "Fly Screen [OFF]"
FlyBtn.TextColor3 = TEXT_COLOR
FlyBtn.TextSize = 15
FlyBtn.Font = Enum.Font.GothamSemibold
FlyBtn.Parent = Content
addCorner(FlyBtn, 8)

FlyBtn.MouseButton1Click:Connect(function()
    flyActive = not flyActive
    FlyGui.Visible = flyActive
    FlyBtn.Text = flyActive and "Fly Screen [ON]" or "Fly Screen [OFF]"
    FlyBtn.BackgroundColor3 = flyActive and BUTTON_ON or BUTTON_OFF

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if flyActive and hrp then
        bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bg = Instance.new("BodyGyro", hrp)
        bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)

        flyConn = RunService.RenderStepped:Connect(function()
            if not flyActive or not hrp then return end
            local cam = workspace.CurrentCamera.CFrame
            local dir = Vector3.zero

            if flyMove.fwd == 1 then dir = dir + cam.LookVector end
            if flyMove.back == 1 then dir = dir - cam.LookVector end
            if flyMove.left == 1 then dir = dir - cam.RightVector end
            if flyMove.right == 1 then dir = dir + cam.RightVector end
            if flyMove.up == 1 then dir = dir + Vector3.new(0, 1, 0) end
            if flyMove.down == 1 then dir = dir - Vector3.new(0, 1, 0) end

            bv.Velocity = dir * 60
            bg.CFrame = cam
        end)
    else
        if flyConn then flyConn:Disconnect() end
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        for k in pairs(flyMove) do flyMove[k] = 0 end
    end
end)
