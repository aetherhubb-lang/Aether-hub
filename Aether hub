local function verificar()
    if box.Text == "AETHER-X" then
        status.Text = "Acesso Concedido!"
        status.TextColor3 = Color3.fromRGB(60, 200, 100)
        task.wait(0.5)
        abrirHub()
    else
        status.Text = "Key invalida"
        box.Text = ""
    end
end

