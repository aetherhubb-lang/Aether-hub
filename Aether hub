local AM = {
    Ativo = false, Voando = false,
    VIDA_MINIMA = 35, VIDA_SEGURA = 90,
    ALTURA_MAX = 1500, VELOCIDADE_SUBIDA = 250, VELOCIDADE_DESCIDA = 180,
    INTERVALO = 0.1, BV = nil, BG = nil, Estado = "idle",
}

local function amGetHRP() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function amGetHum() local c = lp.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function amGetHP()
    local h = amGetHum()
    if not h then return 100 end
    return (h.Health / math.max(h.MaxHealth, 1)) * 100
end

local function amLimparFisica()
    local r = amGetHRP()
    if not r then return end
    for _, v in ipairs(r:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
    end
    AM.BV = nil AM.BG = nil
end

local function amCriarFisica(velY)
    local r, h = amGetHRP(), amGetHum()
    if not r or not h then return end
    amLimparFisica()
    h.PlatformStand = true
    h.AutoRotate = false
    AM.BV = Instance.new("BodyVelocity")
    AM.BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    AM.BV.Velocity = Vector3.new(0, velY, 0)
    AM.BV.Parent = r
    AM.BG = Instance.new("BodyGyro")
    AM.BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    AM.BG.CFrame = r.CFrame
    AM.BG.Parent = r
end

local function amPararTudo()
    amLimparFisica()
    local h = amGetHum()
    if h then h.PlatformStand = false h.AutoRotate = true end
    AM.Voando = false
    AM.Estado = "idle"
end

local function amRaycastChao()
    local r = amGetHRP()
    if not r then return 999 end
    local p = RaycastParams.new()
    p.FilterDescendantsInstances = {lp.Character}
    p.FilterType = Enum.RaycastFilterType.Exclude
    local res = workspace:Raycast(r.Position, Vector3.new(0,-20,0), p)
    return res and res.Distance or 999
end

local function amLoop()
    while AM.Ativo do
        task.wait(AM.INTERVALO)
        local hp = amGetHP()
        local r = amGetHRP()
        local h = amGetHum()
        if not r or not h or h.Health <= 0 then AM.Estado = "idle" continue end

        if hp < AM.VIDA_MINIMA and AM.Estado ~= "subindo" and AM.Estado ~= "pairando" then
            AM.Estado = "subindo"
            AM.Voando = true
            sLabel.Text = "💀 VIDA BAIXA → SUBINDO!"
            sLabel.TextColor3 = C.R
            amCriarFisica(AM.VELOCIDADE_SUBIDA)
        end

        if AM.Estado == "subindo" then
            if r.Position.Y >= AM.ALTURA_MAX then
                AM.Estado = "pairando"
                sLabel.Text = "🛡️ PAIRANDO"
                sLabel.TextColor3 = C.VN
            elseif AM.BV and AM.BV.Parent then
                AM.BV.Velocity = Vector3.new(0, AM.VELOCIDADE_SUBIDA, 0)
            end
        end

        if AM.Estado == "pairando" then
            if r.Position.Y > AM.ALTURA_MAX then
                r.CFrame = CFrame.new(r.Position.X, AM.ALTURA_MAX, r.Position.Z)
            end
            if hp >= AM.VIDA_SEGURA then
                AM.Estado = "descendo"
                sLabel.Text = "✅ CURADO → DESCENDO..."
                sLabel.TextColor3 = C.VN
                amCriarFisica(-AM.VELOCIDADE_DESCIDA)
            end
        end

        if AM.Estado == "descendo" then
            local dist = amRaycastChao()
            if dist < 6 then
                AM.Estado = "idle"
                AM.Voando = false
                amPararTudo()
                sLabel.Text = "✅ Anti-Morte: Protegido"
                sLabel.TextColor3 = C.VN
            elseif AM.BV and AM.BV.Parent then
                AM.BV.Velocity = Vector3.new(0, -AM.VELOCIDADE_DESCIDA, 0)
            end
        end

        if AM.Estado == "idle" and hp >= AM.VIDA_MINIMA then
            sLabel.Text = "✅ Monitorando ("..math.floor(hp).."%)"
            sLabel.TextColor3 = C.VN
        end
    end
    amPararTudo()
    sLabel.Text = "Sem Serviço"
    sLabel.TextColor3 = C.TS
end

