-- SISTEMA GOJO 0.2 + BYPASS
--=================================================================
local gojoAtivo = false
local gojoConn = nil
local bypassAtivo = false

local function matarTodosRapido()
    local alvos = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then table.insert(alvos, hrp) end
        end
    end
    for _, hrp in ipairs(alvos) do
        pcall(function()
            LocalPlayer.Character.HumanoidRootPart.CFrame = hrp.CFrame
            task.wait(0.02)
        end)
    end
end

local function iniciarGojo()
    if gojoConn then gojoConn:Disconnect() end
    gojoConn = RunService.Heartbeat:Connect(function()
        if not gojoAtivo then return end
        pcall(function()
            if not LocalPlayer.Character then return end
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)

            if bypassAtivo then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local thrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if thrp then
                            hrp.CFrame = thrp.CFrame
                            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                            if hum then hum.Health = 0 end
                        end
                    end
                end
            else
                matarTodosRapido()
            end
        end)
    end)
end

