local AbaAtual = nil

local function trocarAba(nomeAba)
    for nome, dados in pairs(Abas) do
        if nome == nomeAba then
            dados.frame.Visible = true
            dados.botao.BackgroundColor3 = COR_ABA_ATIVA
            dados.botao.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            dados.frame.Visible = false
            dados.botao.BackgroundColor3 = COR_ABA_OFF
            dados.botao.TextColor3 = COR_TEXTO_OFF
        end
    end
    ContentTitle.Text = nomeAba
    AbaAtual = nomeAba
end

local function criarAba(nome, ordem)
    local botao = Instance.new("TextButton")
    botao.Size = UDim2.new(1, 0, 0, 34)
    botao.BackgroundColor3 = COR_ABA_OFF
    botao.BorderSizePixel = 0
    botao.Text = nome
    botao.TextColor3 = COR_TEXTO_OFF
    botao.Font = Enum.Font.GothamMedium
    botao.TextSize = 12
    botao.LayoutOrder = ordem
    botao.AutoButtonColor = false
    botao.Parent = TabList
    Instance.new("UICorner", botao).CornerRadius = UDim.new(0, 8)

    local abaFrame = Instance.new("Frame")
    abaFrame.Size = UDim2.new(1, 0, 0, 0)
    abaFrame.BackgroundTransparency = 1
    abaFrame.Visible = false
    abaFrame.Parent = FunctionList

    local abaLayout = Instance.new("UIListLayout")
    abaLayout.Padding = UDim.new(0, 7)
    abaLayout.SortOrder = Enum.SortOrder.LayoutOrder
    abaLayout.Parent = abaFrame

    abaLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        abaFrame.Size = UDim2.new(1, 0, 0, abaLayout.AbsoluteContentSize.Y + 10)
    end)

    botao.MouseButton1Click:Connect(function()
        trocarAba(nome)
    end)

    Abas[nome] = { botao = botao, frame = abaFrame }
    if not AbaAtual then trocarAba(nome) end
    return abaFrame
end

local function criarToggle(parent, texto, ordem, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 46)
    row.BackgroundColor3 = Color3.fromRGB(32, 22, 48)
    row.BorderSizePixel = 0
    row.LayoutOrder = ordem
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.72, 0, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = texto
    lbl.TextColor3 = Color3.fromRGB(230, 220, 250)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local toggleBg = Instance.new("Frame")
    toggleBg.Size = UDim2.new(0, 42, 0, 24)
    toggleBg.Position = UDim2.new(1, -56, 0.5, -12)
    toggleBg.BackgroundColor3 = COR_TOGGLE_OFF
    toggleBg.BorderSizePixel = 0
    toggleBg.Parent = row
    Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 18, 0, 18)
    circle.Position = UDim2.new(0, 3, 0.5, -9)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    circle.Parent = toggleBg
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = row

    local estado = false
    click.MouseButton1Click:Connect(function()
        estado = not estado
        if estado then
            toggleBg.BackgroundColor3 = COR_TOGGLE_ON
            circle.Position = UDim2.new(1, -21, 0.5, -9)
        else
            toggleBg.BackgroundColor3 = COR_TOGGLE_OFF
            circle.Position = UDim2.new(0, 3, 0.5, -9)
        end
        if callback then
            local ok, err = pcall(callback, estado)
            if not ok then warn("[Aether] " .. tostring(err)) end
        end
    end)

    return row, click
end

local function criarBotao(parent, texto, ordem, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(60, 38, 95)
    b.BorderSizePixel = 0
    b.Text = texto
    b.TextColor3 = Color3.fromRGB(230, 210, 255)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.LayoutOrder = ordem
    b.AutoButtonColor = false
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Color3.fromRGB(90, 55, 145)
    end)

    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = Color3.fromRGB(60, 38, 95)
    end)

    b.MouseButton1Click:Connect(function()
        if callback then
            local ok, err = pcall(callback)
            if not ok then warn("[Aether] " .. tostring(err)) end
        end
    end)

    return b
end

