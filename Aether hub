if dir.C then mv=mv+Vector3.new(0,1,0)end
if dir.B then mv=mv-Vector3.new(0,1,0)end
if mv.Magnitude>0 then mv=mv.Unit*sp end
if not hrp:FindFirstChild("ABV")then local bv=Instance.new("BodyVelocity")bv.Name="ABV"bv.MaxForce=Vector3.new(1e5,1e5,1e5)bv.Parent=hrp end
