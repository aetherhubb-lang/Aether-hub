pcall(function()local hrp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")if hrp then if hrp:FindFirstChild("ABV")then hrp.ABV:Destroy()end if hrp:FindFirstChild("ABG")then hrp.ABG:Destroy()end end end)
end
local focus=false focusConn=nil
local function inimigoMaisProximo()
local ch=LocalPlayer.Character if not ch then return nil end
local hrp=ch:FindFirstChild("HumanoidRootPart")if not hrp then return nil end
local maisPerto=nil dist=9999
for _,p in ipairs(Players:GetPlayers())do
if p~=LocalPlayer and p.Character then
local t=p.Character:FindFirstChild("HumanoidRootPart")
local h=p.Character:FindFirstChildOfClass("Humanoid")
if t and h and h.Health>0 then
local d=(t.Position-hrp.Position).Magnitude
if d<dist then dist=d maisPerto=t end
end
end end
return maisPerto
end
local function startFocus()
if focusConn then focusConn:Disconnect()end
local ang=0
local alvoTravado=nil
focusConn=RunService.Heartbeat:Connect(function(dt)if not focus then return end pcall(function()
local ch=LocalPlayer.Character if not ch then return end
local hrp=ch:FindFirstChild("HumanoidRootPart")if not hrp then return end
if alvoTravado then
local h=alvoTravado.Parent and alvoTravado.Parent:FindFirstChildOfClass("Humanoid")
if not h or h.Health<=0 then alvoTravado=nil end
end
if not alvoTravado then alvoTravado=inimigoMaisProximo()end
if alvoTravado then
ang=ang+dt*10
local raio=4
local pos=alvoTravado.Position+Vector3.new(math.cos(ang)*raio,1.5,math.sin(ang)*raio)
hrp.CFrame=CFrame.lookAt(pos,alvoTravado.Position)
local hum=ch:FindFirstChildOfClass("Humanoid")
if hum then hum.AutoRotate=false end
end
end)end)
end
local function stopFocus()
if focusConn then focusConn:Disconnect()focusConn=nil end
pcall(function()
local ch=LocalPlayer.Character
if ch then
local hum=ch:FindFirstChildOfClass("Humanoid")
if hum then hum.AutoRotate=true end
end
end)
end
