-- Loop Lógica de Voo
local flySpeed = 60
RunService.RenderStepped:Connect(function()
    FlyControlsGui.Enabled = States.Fly
    local char = LocalPlayer.Character
    if States.Fly and char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local cam = Workspace.CurrentCamera
        local moveVec = Vector3.zero

        if FlyDirs.Forward then moveVec = moveVec + cam.CFrame.LookVector end
        if FlyDirs.Backward then moveVec = moveVec - cam.CFrame.LookVector end
        if FlyDirs.Right then moveVec = moveVec + cam.CFrame.RightVector end
        if FlyDirs.Left then moveVec = moveVec - cam.CFrame.RightVector end
        if FlyDirs.Up then moveVec = moveVec + Vector3.new(0, 1, 0) end
        if FlyDirs.Down then moveVec = moveVec - Vector3.new(0, 1, 0) end

        if moveVec.Magnitude > 0 then
            hrp.Velocity = moveVec.Unit * flySpeed
        else
            hrp.Velocity = Vector3.zero
        end
    end
end)
