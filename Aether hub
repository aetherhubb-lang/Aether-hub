    sub.TextColor3 = Color3.fromRGB(160, 130, 200)
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 14
    sub.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 260, 0, 40)
    box.Position = UDim2.new(0.5, -130, 0, 100)
    box.BackgroundColor3 = Color3.fromRGB(35, 20, 55)
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = "AETHER-X"
    box.TextColor3 = Color3.fromRGB(220, 200, 255)
    box.PlaceholderColor3 = Color3.fromRGB(130, 100, 180)
    box.Font = Enum.Font.Gotham
    box.TextSize = 16
    box.ClearTextOnFocus = false
    box.Parent = frame

    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 10); bc.Parent = box
    local bs = Instance.new("UIStroke")
    bs.Color = Color3.fromRGB(180, 130, 255); bs.Thickness = 1.5; bs.Transparency = 0.3
    bs.Parent = box

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 260, 0, 40)
    btn.Position = UDim2.new(0.5, -130, 0, 150)
    btn.BackgroundColor3 = Color3.fromRGB(130, 80, 220)
    btn.BorderSizePixel = 0
    btn.Text = "Verificar"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = frame

    local bbc = Instance.new("UICorner"); bbc.CornerRadius = UDim.new(0, 10); bbc.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 20)
    status.Position = UDim2.new(0, 0, 0, 200)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(255, 80, 80)
    status.Font = Enum.Font.Gotham
    status.TextSize = 13
    status.Parent = frame

    local verified = false
    local function tryVerify()
        if verified then return end
        if box.Text == KEY then
            verified = true
            status.Text = "✔ Acesso Concedido"
            status.TextColor3 = Color3.fromRGB(120, 255, 120)
            task.wait(0.7)
            gui:Destroy()
            _G.AetherAuthenticated = true
            loadMainHub()
        else
            status.Text = "✘ Key inválida"
            box.Text = ""
        end
    end

    btn.MouseButton1Click:Connect(tryVerify)
    box.FocusLost:Connect(function(enter)
        if enter then tryVerify() end
    end)
end

