local gojo=false gojoRunning=false bypass=false
local function startGojo()
if gojoRunning then return end
gojoRunning=true
task.spawn(function()
while gojo do
pcall(function()
local ch=LocalPlayer.Character
if ch then
local hrp=ch:FindFirstChild("HumanoidRootPart")
if hrp then
local hum=ch:FindFirstChildOfClass("Humanoid")
if hum then hum.MaxHealth=math.huge hum.Health=math.huge end
for _,p in ipairs(Players:GetPlayers())do
if not gojo then break end
if p~=LocalPlayer and p.Character then
local t=p.Character:FindFirstChild("HumanoidRootPart")
local th=p.Character:FindFirstChildOfClass("Humanoid")
if t and th and th.Health>0 then
hrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
hrp.CFrame=t.CFrame*CFrame.new(0,0,-1)
task.wait(0.03)
local tool=ch:FindFirstChildOfClass("Tool")
if tool then pcall(function()tool:Activate()end)end
if bypass then pcall(function()th.Health=0 end)end
end
end
end
end
end
end)
task.wait(0.05)
end
gojoRunning=false
end)
end
