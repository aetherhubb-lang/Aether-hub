                    root.CFrame = CFrame.new(ultimaPos)
                    print(string.format("[Aether] 🚫 Kokusen bloqueado: %.0f studs", dist))
                end
            end

            ultimaPos = root.Position
        end)
    end

    local function pararMonitor()
        if monitorConn then
            monitorConn:Disconnect()
            monitorConn = nil
        end
        ultimaPos = nil
    end

