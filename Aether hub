-- Estados das Funções
local States = {
    Gojo = false,
    Fly = false,
    Focus = false
}

local function CreateToggleButton(name, keyState)
    local Btn = Instance.new("TextButton", MenuContainer)
    Btn.Size = UDim2.new(1, 0, 0, 38)
    Btn.Text = name .. ": [OFF]"
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.BackgroundColor3 = Color3.fromRGB(28, 25, 38)
    Btn.Font = Enum.Font.Gotham
    Btn.TextSize = 13

    local BtnCorner = Instance.new("UICorner", Btn)
    BtnCorner.CornerRadius = UDim.new(0, 8)

    Btn.MouseButton1Click:Connect(function()
        States[keyState] = not States[keyState]
        if States[keyState] then
            Btn.Text = name .. ": [ON]"
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            Btn.Text = name .. ": [OFF]"
            Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end)
    return Btn
end

CreateToggleButton("Gojo 0.2", "Gojo")
CreateToggleButton("Fly Mobile", "Fly")
