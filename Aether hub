local Tabs = {}

local function CreateTab(tabName)
    local TabButton = Instance.new("TextButton", Sidebar)
    TabButton.Size = UDim2.new(1, 0, 0, 30)
    TabButton.Text = tabName
    TabButton.TextColor3 = NeonPurpleTheme.Text
    TabButton.BackgroundColor3 = NeonPurpleTheme.Primary
    TabButton.Font = Enum.Font.GothamBold
    TabButton.TextSize = 12
    TabButton.BorderSizePixel = 0

    local Page = Instance.new("ScrollingFrame", ContentArea)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.CanvasSize = UDim2.new(0, 0, 2, 0)
    Page.ScrollBarThickness = 4

    local PageList = Instance.new("UIListLayout", Page)
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Padding = UDim.new(0, 8)

    TabButton.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = NeonPurpleTheme.Primary
        end
        Page.Visible = true
        TabButton.BackgroundColor3 = NeonPurpleTheme.Accent
    end)

    table.insert(Tabs, {Button = TabButton, Page = Page})
    
    if #Tabs == 1 then
        Page.Visible = true
        TabButton.BackgroundColor3 = NeonPurpleTheme.Accent
    end

    return Page
end

local function AddButton(page, text, callback)
    local Btn = Instance.new("TextButton", page)
    Btn.Size = UDim2.new(0.95, 0, 0, 35)
    Btn.Text = text
    Btn.TextColor3 = NeonPurpleTheme.Text
    Btn.BackgroundColor3 = NeonPurpleTheme.Secondary
    Btn.Font = Enum.Font.Gotham
    Btn.TextSize = 13
    Btn.BorderSizePixel = 0

    local Stroke = Instance.new("UIStroke", Btn)
    Stroke.Color = NeonPurpleTheme.Accent
    Stroke.Thickness = 1

    Btn.MouseButton1Click:Connect(callback)
end

