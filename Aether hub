local flyOn = false
local flyM = {l=0, r=0, u=0, d=0}
local flyG, flyV, flyA, flyC
local flyB, flyS = mkBtn("🕊️ Fly", 2)

local function createFly()
    if flyG then flyG:Destroy() end
    flyG = Instance.new("ScreenGui", CoreGui)
    flyG.Name = "AetherFlyUI"
    flyG.ResetOnSpawn = false
    flyG.DisplayOrder = 999999
    local function arr(x, y, t, k)
        local b = Instance.new("TextButton", flyG)
        b.Size = UDim2.new(0, 58, 0, 58)
        b.Position = UDim2.new(0, x, 0, y)
        b.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
        b.BorderSizePixel = 0
        b.Text = t
        b.TextColor3 = Color3.fromRGB(240, 215, 255)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 28
        b.RichText = false
        b.AutoButtonColor = false
        Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
        local s = Instance.new("UIStroke", b)
        s.Color = R
        s.Thickness = 2.5
        b.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                flyM[k] = 1
                b.BackgroundColor3 = Color3.fromRGB(140, 90, 230)
            end
        end)
        b.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                flyM[k] = 0
                b.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
            end
        end)
    end
    arr(80, 60, "▲", "u")
    arr(15, 125, "◀", "l")
    arr(145, 125, "▶", "r")
    arr(80, 190, "▼", "d")
end

local function stopFly()
    if flyC then flyC:Disconnect() flyC = nil end
    if flyV then flyV:Destroy() flyV = nil end
    if flyA then flyA:Destroy() flyA = nil end
    local ch = LP.Character
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    if h then h.PlatformStand = false end
    for k in pairs(flyM) do flyM[k] = 0 end
end

local function startFly()
    local ch = LP.Character
    local rt = ch and ch:FindFirstChild("HumanoidRootPart")
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    if not rt or not h then return end
    h.PlatformStand = true
    flyV = Instance.new("BodyVelocity", rt)
    flyV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyV.Velocity = Vector3.zero
    flyA = Instance.new("BodyAngularVelocity", rt)
    flyA.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyA.AngularVelocity = Vector3.zero
    flyC = RunService.Heartbeat:Connect(function()
        if not flyOn then return end
        local c = LP.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        local cam = workspace.CurrentCamera
        local v = Vector3.zero
        v = v + cam.CFrame.RightVector * (flyM.r - flyM.l) * 90
        v = v + cam.CFrame.LookVector * (flyM.u - flyM.d) * 90
        if flyV then flyV.Velocity = v end
    end)
end

flyB.MouseButton1Click:Connect(function()
    flyOn = not flyOn
    flyS(flyOn)
    if flyOn then createFly() startFly() else
        if flyG then flyG:Destroy() flyG = nil end
        stopFly()
    end
end)

