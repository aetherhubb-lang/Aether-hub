local function createKeyGui()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AetherKey"
    gui.ResetOnSpawn = false
    gui.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 220)
    frame.Position = UDim2.new(0.5, -150, 0.5, -110)
    frame.BackgroundColor3 = Color3.fromRGB(18, 12, 28)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 18)

    -- Gradiente de fundo
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 20, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 10, 25)),
    })
    grad.Rotation = 45
    grad.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(160, 100, 255)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.2
    stroke.Parent = frame

    -- Brilho da borda (animação)
    task.spawn(function()
        while frame.Parent do
            for i = 0, 1, 0.05 do
                if not frame.Parent then break end
                stroke.Transparency = 0.15 + math.abs(math.sin(i * math.pi)) * 0.35
                task.wait(0.04)
            end
        end
    end)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 45)
    title.Position = UDim2.new(0, 0, 0, 14)
    title.BackgroundTransparency = 1
    title.Text = "🌌  AETHER HUB"
    title.TextColor3 = Color3.fromRGB(200, 160, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 22
    title.Parent = frame

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, 0, 0, 18)
    sub.Position = UDim2.new(0, 0, 0, 58)
    sub.BackgroundTransparency = 1
    sub.Text = "Digite a Key de Acesso"
    sub.TextColor3 = Color3.fromRGB(150, 120, 200)
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 12
    sub.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 230, 0, 38)
    box.Position = UDim2.new(0.5, -115, 0, 90)
    box.BackgroundColor3 = Color3.fromRGB(28, 18, 48)
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = "Digite sua key..."
    box.TextColor3 = Color3.fromRGB(220, 200, 255)
    box.PlaceholderColor3 = Color3.fromRGB(110, 85, 160)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Color3.fromRGB(120, 80, 200)
    boxStroke.Thickness = 1
    boxStroke.Transparency = 0.5
    boxStroke.Parent = box

    box.Focused:Connect(function()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(180, 120, 255)}):Play()
    end)
    box.FocusLost:Connect(function()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(120, 80, 200)}):Play()
    end)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 230, 0, 38)
    btn.Position = UDim2.new(0.5, -115, 0, 138)
    btn.BackgroundColor3 = Color3.fromRGB(130, 70, 220)
    btn.BorderSizePixel = 0
    btn.Text = "✦  Verificar"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.AutoButtonColor = false
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local btnGrad = Instance.new("UIGradient")
    btnGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 100, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 50, 200)),
    })
    btnGrad.Rotation = 90
    btnGrad.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(160, 100, 245)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(130, 70, 220)}):Play()
    end)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 18)
    status.Position = UDim2.new(0, 0, 0, 188)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(220, 80, 100)
    status.Font = Enum.Font.Gotham
    status.TextSize = 12
    status.Parent = frame

    local function tryVerify()
        local keyDigitada = box.Text
        if keyDigitada == "" then
            status.Text = "✘ Digite uma key!"
            return
        end
        local idEsperado = KeysAutorizadas[keyDigitada]
        if not idEsperado then
            status.Text = "✘ Key inválida"
            box.Text = ""
            return
        end
        if idEsperado ~= LP.UserId then
            status.Text = "✘ Key não pertence a você"
            return
        end
        status.Text = "✔ Acesso Concedido"
        status.TextColor3 = Color3.fromRGB(60, 220, 100)
        task.wait(0.9)
        gui:Destroy()
        _G.AetherAuthenticated = true
        loadMainHub()
    end

    btn.MouseButton1Click:Connect(tryVerify)
    box.FocusLost:Connect(function(enter)
        if enter then tryVerify() end
    end)
end

