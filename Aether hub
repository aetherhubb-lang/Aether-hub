        monC = RunService.Heartbeat:Connect(function()
            local ch = LP.Character
            local rt = ch and ch:FindFirstChild("HumanoidRootPart")
            if not rt then ultP = nil return end
            if not kokusenOn then ultP = rt.Position return end
            if ultP and (rt.Position - ultP).Magnitude > LIM then
                rt.CFrame = CFrame.new(ultP)
            end
            ultP = rt.Position
