local function startFly()
if flyConn then flyConn:Disconnect()end
criaFly()
flyConn=RunService.RenderStepped:Connect(function()if not fly then return end pcall(function()
local ch=LocalPlayer.Character if not ch then return end
local hrp=ch:FindFirstChild("HumanoidRootPart")if not hrp then return end
local sp=120 mv=Vector3.new(0,0,0)cf=Camera.CFrame
if dir.F then mv=mv+cf.LookVector end
if dir.T then mv=mv-cf.LookVector end
if dir.E then mv=mv-cf.RightVector end
