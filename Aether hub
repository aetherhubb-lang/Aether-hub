    --════════════════════════════════════════════════
    -- BYPASS
    --════════════════════════════════════════════════
    local bypassActive = false
    local bypassBtn = makeButton("Bypass: OFF", 3)

    local function AtualizarChar()
        local char = LP.Character or LP.CharacterAdded:Wait()
        return char,
               char:WaitForChild("HumanoidRootPart", 5),
               char:WaitForChild("Humanoid", 5)
    end

    local function ExecutarBypass()
        local char, root = AtualizarChar()
        if not root then return false end
        local sucesso = false
        pcall(function()
            local jogadores = Players:GetPlayers()
            for i = #jogadores, 1, -1 do
                if jogadores[i] == LP then table.remove(jogadores, i) end
            end
            if #jogadores > 0 then
                local alvo = jogadores[math.random(1, #jogadores)]
                if alvo and alvo.Character
                   and alvo.Character:FindFirstChild("HumanoidRootPart") then
                    local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                    root.CFrame = CFrame.new(posAlvo)
                    task.wait(0.5)
                    if root and root.Parent
                       and (root.Position - posAlvo).Magnitude < 25 then
                        sucesso = true
                    end
                end
            end
        end)
        return sucesso
    end

    local function rotaDoVoid()
        local char, root, hum = AtualizarChar()
        if not root or not hum then return end
        pcall(function()
            hum.PlatformStand = true
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(9999999, 9999999, 9999999)
            bv.Velocity = Vector3.new(0, 100, 0)
            bv.Parent = root
            task.wait(1.5)
            bv.Velocity = Vector3.new(-700, 0, 0)
            task.wait(2)
            bv.Velocity = Vector3.zero
            hum.PlatformStand = false
            bv:Destroy()
        end)
    end

    bypassBtn.MouseButton1Click:Connect(function()
        bypassActive = not bypassActive
        bypassBtn.Text = "Bypass: " .. (bypassActive and "ON" or "OFF")
        if bypassActive then
            task.spawn(function()
                local tentativas = 0
                while bypassActive do
                    tentativas += 1
                    print("💀 Bypass tentativa #" .. tentativas)
                    local ok = ExecutarBypass()
                    if ok then
                        print("✅ Bypass FUNCIONOU na tentativa #" .. tentativas)
                        bypassActive = false
                        bypassBtn.Text = "Bypass: OFF"
                        break
                    else
                        print("❌ Falhou #" .. tentativas .. " - Resetando...")
                        rotaDoVoid()
                        task.wait(3)
                    end
                end
            end)
        end
    end)

    --════════════════════════════════════════════════
    -- FOCUS (personagem orbita o alvo)
    --════════════════════════════════════════════════
    local focusActive = false
    local focusBtn = makeButton("Focus: OFF", 4)
    local focusConn, focusTarget

    local function findNearest()
        local c = LP.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return nil end
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local tr = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if tr and hum and hum.Health > 0 then
                    local d = (tr.Position - r.Position).Magnitude
                    if d < bestD then bestD = d; best = p end
                end
            end
        end
        return best
    end

    local function stopFocus()
        if focusConn then focusConn:Disconnect(); focusConn = nil end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        focusTarget = nil
    end

    local function startFocus()
        focusTarget = findNearest()
        if not focusTarget then
            focusActive = false
            focusBtn.Text = "Focus: OFF"
            return
        end

        local angle = 0
        local radius = 6
        local speed = 5
        local heightOffset = 3

        focusConn = RunService.Heartbeat:Connect(function(dt)
            if not focusActive then return end

            if not focusTarget or not focusTarget.Character
               or not focusTarget.Character.Parent then
                focusTarget = findNearest()
                if not focusTarget then return end
            end

            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local tr   = focusTarget.Character:FindFirstChild("HumanoidRootPart")
            local tHum = focusTarget.Character:FindFirstChildOfClass("Humanoid")

            if not root or not hum or not tr then return end
            if tHum and tHum.Health <= 0 then
                focusTarget = findNearest()
                return
            end

            hum.PlatformStand = true

            angle += dt * speed
            local offset = Vector3.new(math.cos(angle) * radius, heightOffset, math.sin(angle) * radius)
            local newPos = tr.Position + offset

            root.CFrame = CFrame.new(newPos, tr.Position)
            root.Velocity = Vector3.zero
        end)
    end

    focusBtn.MouseButton1Click:Connect(function()
        focusActive = not focusActive
        focusBtn.Text = "Focus: " .. (focusActive and "ON" or "OFF")
        if focusActive then startFocus() else stopFocus() end
    end)

