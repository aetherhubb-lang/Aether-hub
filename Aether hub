local aimOn = false
local aimC = nil
local aimB, aimS = mkBtn("🎯 Aim Lock", 5)
aimB.MouseButton1Click:Connect(function()
    aimOn = not aimOn
    aimS(aimOn)
    if aimOn then
        if not aimC then
            aimC = RunService.RenderStepped:Connect(function()
                if not aimOn then return end
                local mc = LP.Character
                local mr = mc and mc:FindFirstChild("HumanoidRootPart")
                if not mr then return end
                local best, bd = nil, 300
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        local hd = p.Character:FindFirstChild("Head")
                        local hr = p.Character:FindFirstChild("HumanoidRootPart")
                        local hm = p.Character:FindFirstChildOfClass("Humanoid")
                        if hd and hr and hm and hm.Health > 0 then
                            local d = (hr.Position - mr.Position).Magnitude
                            if d < bd then bd = d best = hd end
                        end
                    end
                end
                if best then
                    local cam = workspace.CurrentCamera
                    if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, best.Position) end
                end
            end)
        end
    else
        if aimC then aimC:Disconnect() aimC = nil end
    end
end)

