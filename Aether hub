--// FUNÇÕES AUXILIARES
local function criarCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function criarStroke(parent, cor, esp)
    local s = Instance.new("UIStroke")
    s.Color = cor
    s.Thickness = esp or 1.5
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end--=====================================================================
