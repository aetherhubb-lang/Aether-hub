            b.AutoButtonColor = false
            Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
            local ss = Instance.new("UIStroke", b)
            ss.Color = R
            ss.Thickness = 2.5
            b.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    flyM[k] = 1
                end
            end)
            b.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    flyM[k] = 0
                end
            end)
        end
        arr(80, 60, "▲", "u")
        arr(15, 125, "◀", "l")
        arr(145, 125, "▶", "r")
        arr(80, 190, "▼", "d")
    end

    local function stopFly()
        if flyC then flyC:Disconnect() flyC = nil end
        if flyV then flyV:Destroy() flyV = nil end
        if flyA then flyA:Destroy() flyA = nil end
        local ch = LP.Character
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
        for k in pairs(flyM) do flyM[k] = 0 end
    end

    local function startFly()
        local ch = LP.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if not rt or not h then return end
        h.PlatformStand = true
        flyV = Instance.new("BodyVelocity", rt)
        flyV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        flyV.Velocity = Vector3.zero
        flyA = Instance.new("BodyAngularVelocity", rt)
        flyA.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        flyA.AngularVelocity = Vector3.zero
        flyC = RunService.Heartbeat:Connect(function()
            if not flyOn then return end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local cam = workspace.CurrentCamera
            local v = Vector3.zero
            v = v + cam.CFrame.RightVector * (flyM.r - flyM.l) * 90
            v = v + cam.CFrame.LookVector * (flyM.u - flyM.d) * 90
            if flyV then flyV.Velocity = v end
        end)
    end

