local function mkBtn(txt, ord)
    local row = Instance.new("Frame", list)
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3 = BGP
    row.BorderSizePixel = 0
    row.LayoutOrder = ord
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local rs = Instance.new("UIStroke", row)
    rs.Color = Color3.fromRGB(75, 20, 130)
    rs.Thickness = 1
    rs.Transparency = 0.3
    local lb = Instance.new("TextLabel", row)
    lb.Size = UDim2.new(1, -60, 1, 0)
    lb.Position = UDim2.new(0, 12, 0, 0)
    lb.BackgroundTransparency = 1
    lb.Text = txt
    lb.TextColor3 = Color3.fromRGB(220, 200, 240)
    lb.Font = Enum.Font.GothamBold
    lb.TextSize = 13
    lb.TextXAlignment = Enum.TextXAlignment.Left
    local tg = Instance.new("Frame", row)
    tg.Size = UDim2.new(0, 38, 0, 20)
    tg.Position = UDim2.new(1, -50, 0.5, -10)
    tg.BackgroundColor3 = Color3.fromRGB(50, 40, 65)
    tg.BorderSizePixel = 0
    Instance.new("UICorner", tg).CornerRadius = UDim.new(1, 0)
    local c = Instance.new("Frame", tg)
    c.Size = UDim2.new(0, 16, 0, 16)
    c.Position = UDim2.new(0, 2, 0.5, -8)
    c.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    c.BorderSizePixel = 0
    Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
    local clk = Instance.new("TextButton", row)
    clk.Size = UDim2.new(1, 0, 1, 0)
    clk.BackgroundTransparency = 1
    clk.Text = ""
    clk.ZIndex = 5
    local function setOn(v)
        if v then
            TweenService:Create(tg, TweenInfo.new(0.2), {BackgroundColor3 = R}):Play()
            TweenService:Create(c, TweenInfo.new(0.2), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            TweenService:Create(tg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 40, 65)}):Play()
            TweenService:Create(c, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
    end
    return clk, setOn
end

