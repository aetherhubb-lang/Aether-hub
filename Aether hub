    --════════════════════════════════════════════════
    -- FLY (▲ ▼ ◀ ▶ + trava no ar)
    --════════════════════════════════════════════════
    local flyActive = false
    local flyBtn = makeButton("Fly: OFF", 2)
    local flyMove = {left=0, right=0, up=0, down=0}
    local flyGUIRef, flyBV, flyAng, flyConn

    local function createFlyUI()
        if flyGUIRef then flyGUIRef:Destroy() end
        local gui = Instance.new("ScreenGui")
        gui.Name = "AetherFlyUI"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 999999
        gui.Parent = CoreGui
        flyGUIRef = gui

        local function makeArrow(x, y, text, dir)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 75, 0, 75)
            b.Position = UDim2.new(0, x, 0, y)
            b.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
            b.BorderSizePixel = 0
            b.Text = text
            b.TextColor3 = Color3.fromRGB(240, 215, 255)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 36
            b.RichText = false
            b.AutoButtonColor = false
            b.Parent = gui

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = b

            local s = Instance.new("UIStroke")
            s.Color = Color3.fromRGB(180, 130, 255)
            s.Thickness = 3
            s.Parent = b

            b.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                   or input.UserInputType == Enum.UserInputType.Touch then
                    flyMove[dir] = 1
                    b.BackgroundColor3 = Color3.fromRGB(140, 90, 230)
                end
            end)

            b.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                   or input.UserInputType == Enum.UserInputType.Touch then
                    flyMove[dir] = 0
                    b.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
                end
            end)
        end

        makeArrow(100, 80,  "▲", "up")
        makeArrow(25,  165, "◀", "left")
        makeArrow(175, 165, "▶", "right")
        makeArrow(100, 250, "▼", "down")
    end

    local function stopFly()
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyAng then flyAng:Destroy(); flyAng = nil end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        for k in pairs(flyMove) do flyMove[k] = 0 end
    end

    local function startFly()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        hum.PlatformStand = true

        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root

        flyAng = Instance.new("BodyAngularVelocity")
        flyAng.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        flyAng.AngularVelocity = Vector3.zero
        flyAng.Parent = root

        flyConn = RunService.Heartbeat:Connect(function()
            if not flyActive then return end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if not r then return end

            local cam = workspace.CurrentCamera
            local speed = 90
            local vel = Vector3.zero

            vel += cam.CFrame.RightVector * (flyMove.right - flyMove.left) * speed
            vel += Vector3.new(0, 1, 0) * (flyMove.up - flyMove.down) * speed

            if flyBV then flyBV.Velocity = vel end
        end)
    end

    flyBtn.MouseButton1Click:Connect(function()
        flyActive = not flyActive
        flyBtn.Text = "Fly: " .. (flyActive and "ON" or "OFF")
        if flyActive then
            createFlyUI()
            startFly()
        else
            if flyGUIRef then flyGUIRef:Destroy(); flyGUIRef = nil end
            stopFly()
        end
