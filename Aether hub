local Abas = {}
local AbaAtual = nil

local function trocarAba(nomeAba)
    for nome, dados in pairs(Abas) do
        if nome == nomeAba then
            dados.frame.Visible = true
            TweenService:Create(dados.botao, TweenInfo.new(0.25), {BackgroundColor3 = COR_ABA_ATIVA}):Play()
            TweenService:Create(dados.botao, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(dados.botaoStroke, TweenInfo.new(0.25), {Transparency = 0.2}):Play()
        else
            dados.frame.Visible = false
            TweenService:Create(dados.botao, TweenInfo.new(0.25), {BackgroundColor3 = COR_ABA_OFF}):Play()
            TweenService:Create(dados.botao, TweenInfo.new(0.25), {TextColor3 = COR_TEXTO_OFF}):Play()
            TweenService:Create(dados.botaoStroke, TweenInfo.new(0.25), {Transparency = 0.8}):Play()
        end
    end
    ContentTitle.Text = nomeAba
    AbaAtual = nomeAba
end

local function criarAba(nome, ordem)
    local botao = Instance.new("TextButton")
    botao.Size = UDim2.new(1, 0, 0, 34)
    botao.BackgroundColor3 = COR_ABA_OFF
    botao.BorderSizePixel = 0
    botao.Text = nome
    botao.TextColor3 = COR_TEXTO_OFF
    botao.Font = Enum.Font.GothamMedium
    botao.TextSize = 12
    botao.LayoutOrder = ordem
    botao.AutoButtonColor = false
    botao.ZIndex = 4
    botao.Parent = TabList
    Instance.new("UICorner", botao).CornerRadius = UDim.new(0, 8)

    local botaoStroke = Instance.new("UIStroke")
    botaoStroke.Color = COR_ROXO
    botaoStroke.Thickness = 1
    botaoStroke.Transparency = 0.8
    botaoStroke.Parent = botao

    local abaFrame = Instance.new("Frame")
    abaFrame.Size = UDim2.new(1, 0, 0, 0)
    abaFrame.BackgroundTransparency = 1
    abaFrame.Visible = false
    abaFrame.ZIndex = 4
    abaFrame.Parent = FunctionList

    local abaLayout = Instance.new("UIListLayout")
    abaLayout.Padding = UDim.new(0, 7)
    abaLayout.SortOrder = Enum.SortOrder.LayoutOrder
    abaLayout.Parent = abaFrame

    abaLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        abaFrame.Size = UDim2.new(1, 0, 0, abaLayout.AbsoluteContentSize.Y + 10)
    end)

    botao.MouseButton1Click:Connect(function()
        trocarAba(nome)
    end)

    Abas[nome] = { botao = botao, frame = abaFrame, botaoStroke = botaoStroke }
    if not AbaAtual then trocarAba(nome) end
    return abaFrame
end

-- ═══ TOGGLE BONITO ═══
local function criarToggle(parent, texto, ordem, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 46)
    row.BackgroundColor3 = Color3.fromRGB(32, 22, 48)
    row.BorderSizePixel = 0
    row.LayoutOrder = ordem
    row.ZIndex = 4
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local rowStroke = Instance.new("UIStroke")
    rowStroke.Color = COR_ROXO
    rowStroke.Thickness = 1
    rowStroke.Transparency = 0.85
    rowStroke.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.72, 0, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = texto
    lbl.TextColor3 = Color3.fromRGB(230, 220, 250)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 5
    lbl.Parent = row

    local toggleBg = Instance.new("Frame")
    toggleBg.Size = UDim2.new(0, 42, 0, 24)
    toggleBg.Position = UDim2.new(1, -56, 0.5, -12)
    toggleBg.BackgroundColor3 = COR_TOGGLE_OFF
    toggleBg.BorderSizePixel = 0
    toggleBg.ZIndex = 5
    toggleBg.Parent = row
    Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

    local toggleBgStroke = Instance.new("UIStroke")
    toggleBgStroke.Color = COR_ROXO
    toggleBgStroke.Thickness = 1
    toggleBgStroke.Transparency = 0.8
    toggleBgStroke.Parent = toggleBg

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 18, 0, 18)
    circle.Position = UDim2.new(0, 3, 0.5, -9)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    circle.ZIndex = 6
    circle.Parent = toggleBg
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    -- Brilho no círculo quando ativo
    local circleGlow = Instance.new("UIStroke")
    circleGlow.Color = Color3.fromRGB(255, 255, 255)
    circleGlow.Thickness = 2
    circleGlow.Transparency = 1
    circleGlow.Parent = circle

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 7
    click.Parent = row

    local estado = false
    click.MouseButton1Click:Connect(function()
        estado = not estado
        if estado then
            TweenService:Create(toggleBg, TweenInfo.new(0.25), {BackgroundColor3 = COR_TOGGLE_ON}):Play()
            TweenService:Create(toggleBgStroke, TweenInfo.new(0.25), {Transparency = 0.2}):Play()
            TweenService:Create(circle, TweenInfo.new(0.25), {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
            TweenService:Create(rowStroke, TweenInfo.new(0.25), {Transparency = 0.5}):Play()
        else
            TweenService:Create(toggleBg, TweenInfo.new(0.25), {BackgroundColor3 = COR_TOGGLE_OFF}):Play()
            TweenService:Create(toggleBgStroke, TweenInfo.new(0.25), {Transparency = 0.8}):Play()
            TweenService:Create(circle, TweenInfo.new(0.25), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
            TweenService:Create(rowStroke, TweenInfo.new(0.25), {Transparency = 0.85}):Play()
        end
        if callback then
            local ok, err = pcall(callback, estado)
            if not ok then warn("[Aether] " .. tostring(err)) end
        end
    end)

    return row, click
end

-- ═══ BOTÃO BONITO ═══
local function criarBotao(parent, texto, ordem, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(60, 38, 95)
    b.BorderSizePixel = 0
    b.Text = texto
    b.TextColor3 = Color3.fromRGB(230, 210, 255)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.LayoutOrder = ordem
    b.AutoButtonColor = false
    b.ZIndex = 4
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

    local bgGrad = Instance.new("UIGradient")
    bgGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(75, 45, 120)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 30, 85)),
    })
    bgGrad.Rotation = 90
    bgGrad.Parent = b

    local s = Instance.new("UIStroke")
    s.Color = COR_ROXO
    s.Thickness = 1
    s.Transparency = 0.5
    s.Parent = b

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(90, 55, 145)}):Play()
        TweenService:Create(s, TweenInfo.new(0.15), {Transparency = 0.2}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 38, 95)}):Play()
        TweenService:Create(s, TweenInfo.new(0.15), {Transparency = 0.5}):Play()
    end)

    b.MouseButton1Click:Connect(function()
        if callback then
            local ok, err = pcall(callback)
            if not ok then warn("[Aether] " .. tostring(err)) end
        end
    end)

    return b
end

