local flyAtivo = false
local flyConn = nil
local flyGui = nil
local direcoes = {Frente=false, Tras=false, Esq=false, Dir=false, Cima=false, Baixo=false}

local function criarFlyGui()
    if flyGui then flyGui:Destroy() end
    flyGui = Instance.new("ScreenGui")
    flyGui.Name = "AetherFly"
    flyGui.ResetOnSpawn = false
    pcall(function() flyGui.Parent = CoreGui end)
    if not flyGui.Parent then flyGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local function criarSeta(txt, pos, dir)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 55, 0, 55)
        b.Position = pos
        b.BackgroundColor3 = Color3.fromRGB(20, 10, 35)
        b.BorderSizePixel = 0
        b.Text = txt
        b.TextColor3 = Color3.fromRGB(200, 150, 255)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 26
        b.Parent = flyGui
        criarCorner(b, 10)
        local st = criarStroke(b, Color3.fromRGB(160, 100, 255), 1.5)
        st.Transparency = 0.2

        b.MouseButton1Down:Connect(function()
            direcoes[dir] = true
            b.BackgroundColor3 = Color3.fromRGB(80, 40, 140)
        end)
        b.MouseButton1Up:Connect(function()
            direcoes[dir] = false
            b.BackgroundColor3 = Color3.fromRGB(20, 10, 35)
        end)
        b.MouseLeave:Connect(function()
            direcoes[dir] = false
            b.BackgroundColor3 = Color3.fromRGB(20, 10, 35)
        end)
    end

    criarSeta("▲", UDim2.new(0, 15, 0.5, -95), "Frente")
    criarSeta("◀", UDim2.new(0, 15, 0.5, -35), "Esq")
    criarSeta("▼", UDim2.new(0, 15, 0.5, 25), "Tras")
    criarSeta("▶", UDim2.new(0, 15, 0.5, 85), "Dir")

    criarSeta("▲", UDim2.new(1, -70, 0.5, -35), "Cima")
    criarSeta("▼", UDim2.new(1, -70, 0.5, 25), "Baixo")
end

local function iniciarFly()
    if flyConn then flyConn:Disconnect() end
    criarFlyGui()

    flyConn = RunService.RenderStepped:Connect(function()
        if not flyAtivo then return end
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local speed = 120
            local move = Vector3.new(0,0,0)
            local camCF = Camera.CFrame

            if direcoes.Frente then move = move + camCF.LookVector end
            if direcoes.Tras then move = move - camCF.LookVector end
            if direcoes.Esq then move = move - camCF.RightVector end
            if direcoes.Dir then move = move + camCF.RightVector end
            if direcoes.Cima then move = move + Vector3.new(0,1,0) end
            if direcoes.Baixo then move = move - Vector3.new(0,1,0) end

            if move.Magnitude > 0 then
                move = move.Unit * speed
            end

            if not hrp:FindFirstChild("AetherFlyBV") then
                local newBv = Instance.new("BodyVelocity")
                newBv.Name = "AetherFlyBV"
                newBv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                newBv.Velocity = Vector3.new(0,0,0)
                newBv.Parent = hrp
            end
            if not hrp:FindFirstChild("AetherFlyBG") then
                local newBg = Instance.new("BodyGyro")
                newBg.Name = "AetherFlyBG"
                newBg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                newBg.P = 3000
                newBg.CFrame = camCF
                newBg.Parent = hrp
            end

            hrp.AetherFlyBV.Velocity = move
            hrp.AetherFlyBG.CFrame = camCF
        end)
    end)
end

local function pararFly()
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if flyGui then flyGui:Destroy() flyGui = nil end
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if hrp:FindFirstChild("AetherFlyBV") then hrp.AetherFlyBV:Destroy() end
            if hrp:FindFirstChild("AetherFlyBG") then hrp.AetherFlyBG:Destroy() end
        end
    end)
