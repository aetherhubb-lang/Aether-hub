--                      SISTEMA GOJO 0.2 (KILL ALL)                   --
--====================================================================--
task.spawn(function()
    while true do
        if States.Gojo then
            local targets = Players:GetPlayers()
            for _, target in ipairs(targets) do
                if not States.Gojo then break end
                
                if target ~= LocalPlayer and target.Character then
                    local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
                    local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

                    if targetHrp and targetHum and targetHum.Health > 0 and myHrp then
                        -- Teleporta colado no jogador em velocidade máxima
                        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, -1.5)
                        
                        -- Tenta ativar golpes/ferramentas equipadas
                        local tool = myChar:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        task.wait() -- Mínimo intervalo para permitir o processamento de rede
                    end
                end
            end
        else
            task.wait(0.1)
        end
    end
end)

