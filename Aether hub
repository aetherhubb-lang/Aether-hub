-- LÓGICA DE TELEPORTE INSTANTÂNEO E ATAQUE DANO CONTINUO
local function ForceAttack(target)
    local char = LocalPlayer.Character
    if not char then return end

    -- Ativa a ferramenta/habilidade na mão
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end

    -- Dispara remotes de ataque se existirem
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (string.find(string.lower(obj.Name), "m1") or string.find(string.lower(obj.Name), "attack") or string.find(string.lower(obj.Name), "hit")) then
            pcall(function()
                obj:FireServer(target.Character, target.Character:FindFirstChild("HumanoidRootPart"))
            end)
        end
    end
end

-- Loop de alta velocidade utilizando Heartbeat (sem tempo de espera)
RunService.Heartbeat:Connect(function()
    if States.Gojo or States.Focus then
        for _, target in pairs(Players:GetPlayers()) do
            if not (States.Gojo or States.Focus) then break end
            if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChild("Humanoid") then
                if target.Character.Humanoid.Health > 0 then
                    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp then
                        -- Teleporta instantaneamente colado ao jogador
                        myHrp.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -1)
                        ForceAttack(target)
                    end
                end
            end
        end
    end
end)
