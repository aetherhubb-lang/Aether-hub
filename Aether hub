    if KeyInput.Text == CorrectKey then
        KeyBtn.Text = "Key Correta!"
        KeyBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        task.wait(0.8)
        LoadMainHub()
    else
        KeyBtn.Text = "Key Incorreta!"
        KeyBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        task.wait(1)
        KeyBtn.Text = "Confirmar Key"
        KeyBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
    end
end)
