-- ==================== BYPASS SYSTEM ====================
local bypassThread = nil

local function AtualizarChar()
    local char = LP.Character or LP.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart", 5), char:WaitForChild("Humanoid", 5)
end

local function ExecutarBypass()
    local char, root = AtualizarChar()
    if not root then return false end
    local sucesso = false
    pcall(function()
        local jogadores = Players:GetPlayers()
        for i = #jogadores, 1, -1 do
            if jogadores[i] == LP then table.remove(jogadores, i) end
        end
        if #jogadores > 0 then
            local alvo = jogadores[math.random(1, #jogadores)]
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                root.CFrame = CFrame.new(posAlvo)
                task.wait(0.5)
                if root and root.Parent and (root.Position - posAlvo).Magnitude < 25 then
                    sucesso = true
                end
            end
        end
    end)
    return sucesso
end

local function rotaDoVoid()
    local char, root, hum = AtualizarChar()
    if not root or not hum then return end
    pcall(function()
        hum.PlatformStand = true
        local bv = new("BodyVelocity", {
            MaxForce = Vector3.new(9999999, 9999999, 9999999),
            Velocity = Vector3.new(0, 100, 0),
            Parent = root,
        })
        task.wait(1.5)
        bv.Velocity = Vector3.new(-700, 0, 0)
        task.wait(2)
        bv.Velocity = Vector3.zero
        hum.PlatformStand = false
        bv:Destroy()
    end)
end

local function startBypassLoop()
    if bypassThread then return end
    bypassThread = task.spawn(function()
        local tentativas = 0
        while State.bypass do
            tentativas += 1
            local sucesso = ExecutarBypass()
            if sucesso then
                print("✅ Bypass FUNCIONOU na tentativa #" .. tentativas)
                task.wait(2)
            else
                rotaDoVoid()
                task.wait(3)
            end
        end
        bypassThread = nil
    end)
end

-- ==================== FOCUS SYSTEM ====================
local focusTarget = nil
local focusAngle  = 0

local function getNearestPlayer()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local thrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum  = plr.Character:FindFirstChildOfClass("Humanoid")
            if thrp and hum and hum.Health > 0 then
                local d = (thrp.Position - hrp.Position).Magnitude
                if d < bestDist then bestDist, best = d, plr end
            end
        end
    end
    return best
end

RunService.Heartbeat:Connect(function(dt)
    if not State.focus then return end
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not focusTarget or not focusTarget.Character or not focusTarget.Character:FindFirstChild("HumanoidRootPart") then
        focusTarget = getNearestPlayer()
        if not focusTarget then return end
    end
    local targetHrp = focusTarget.Character:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end
    local targetPos = targetHrp.Position
    focusAngle = focusAngle + dt * 10      -- ⬆️ gira 10x mais rápido
    local radius = 2.5                      -- ⬇️ raio menor = colado no inimigo
    local offset = Vector3.new(math.cos(focusAngle) * radius, 2, math.sin(focusAngle) * radius)
    local newPos = targetPos + offset
    pcall(function()
        hrp.CFrame = CFrame.new(newPos, targetPos) -- olha pro alvo
        hrp.Velocity = Vector3.zero                 -- não escorrega
    end)
end)

-- ==================== FLY SYSTEM ====================
local flySpeed = 180

RunService.RenderStepped:Connect(function()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local existing = hrp:FindFirstChild("AetherFlyBV")

    if not State.fly then
        if existing then existing:Destroy() end
        if hum.PlatformStand and hum:GetState() ~= Enum.HumanoidStateType.Dead then
            hum.PlatformStand = false
        end
        return
    end

    hum.PlatformStand = true

    local bv = existing
    if not bv then
        bv = new("BodyVelocity", {
            Name = "AetherFlyBV",
            MaxForce = Vector3.new(1e5, 1e5, 1e5),
            P = 1250,
            D = 50,
            Parent = hrp,
        })
    end

    local cam = workspace.CurrentCamera
    local look = cam.CFrame.LookVector
    local rightV = cam.CFrame.RightVector
    local hLook = Vector3.new(look.X, 0, look.Z)
    if hLook.Magnitude > 0 then hLook = hLook.Unit end
    local hRight = Vector3.new(rightV.X, 0, rightV.Z)
    if hRight.Magnitude > 0 then hRight = hRight.Unit end

    local move = Vector3.zero
    if FlyDirs.fwd   then move = move + hLook end
    if FlyDirs.back  then move = move - hLook end
    if FlyDirs.left  then move = move - hRight end
    if FlyDirs.right then move = move + hRight end
    if FlyDirs.up    then move = move + Vector3.new(0, 1, 0) end
    if FlyDirs.down  then move = move - Vector3.new(0, 1, 0) end

    if move.Magnitude > 0 then
        bv.Velocity = move.Unit * flySpeed
    else
        bv.Velocity = Vector3.zero
    end
end)

