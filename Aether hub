        focusPart.Anchored = true
        focusPart.CanCollide = false
        focusPart.CanQuery = false
        focusPart.CanTouch = false
        focusPart.Parent = workspace

        local light = Instance.new("PointLight")
        light.Color = Color3.fromRGB(180, 100, 255)
        light.Range = 12
        light.Brightness = 2
        light.Parent = focusPart

        local att = Instance.new("Attachment")
        att.Parent = focusPart

        local trail = Instance.new("Trail")
        trail.Attachment0 = att
        trail.Attachment1 = att
        trail.Lifetime = 0.4
        trail.Color = ColorSequence.new(Color3.fromRGB(180, 100, 255))
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1)
        })
        trail.Parent = focusPart
    end

    local function iniciarFocus()
        if focusConn then focusConn:Disconnect() end
        if not focusPart then criarFocus() end

        local angulo = 0
        focusConn = RunService.Heartbeat:Connect(function(dt)
            if not focusAtivo then return end
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp or not focusPart then return end

                angulo = angulo + dt * 3
                local raio = 4
                local offset = Vector3.new(math.cos(angulo) * raio, 1.5, math.sin(angulo) * raio)
                focusPart.CFrame = CFrame.new(hrp.Position + offset)
            end)
        end)
    end

    local function pararFocus()
        if focusConn then focusConn:Disconnect() focusConn = nil end
        if focusPart then focusPart:Destroy() focusPart = nil end
    end

