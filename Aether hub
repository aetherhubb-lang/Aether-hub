local function AdaptTabForRayfield(TabObject)
    if not TabObject then return nil end
    local Adapter = {}
    local function parseTitle(options, fallback)
        if type(options) == "string" then return options end
        if type(options) == "table" then return options.Text or options.Title or options.Name or fallback end
        return fallback
    end
    function Adapter:AddLeftGroupbox() return Adapter end
    function Adapter:AddRightGroupbox() return Adapter end
    function Adapter:AddToggle(id, options)
        options = options or {}
        mkCard(TabObject, parseTitle(options, id), "Toggle", function(a)
            if options.Callback then pcall(options.Callback, a) end
        end)
        return Adapter
    end
    function Adapter:AddSlider(id, options)
        options = options or {}
        mkSlider(TabObject, parseTitle(options, id), options.Min or 0, options.Max or 100, options.Default or options.Min or 0, function(val)
            if options.Callback then pcall(options.Callback, val) end
        end)
        return Adapter
    end
    function Adapter:AddButton(id, options)
        local name = parseTitle(id, "Button")
        local callback = function() end
        if type(options) == "function" then callback = options
        elseif type(options) == "table" then callback = options.Callback or function() end
        elseif type(id) == "table" then callback = id.Callback or function() end end
        mkButton(TabObject, name, "Executar", function() pcall(callback) end)
        return Adapter
    end
    function Adapter:AddDropdown(id, options)
        options = options or {}
        local opts = options.Values or options.Options or {"Opção 1"}
        mkDropdown(TabObject, parseTitle(options, id), opts, function(val)
            if options.Callback then pcall(options.Callback, val) end
        end)
        return Adapter
    end
    function Adapter:AddInput(id, options)
        options = options or {}
        mkInput(TabObject, parseTitle(options, id), options.Placeholder or "Digite...", function(val)
            if options.Callback then pcall(options.Callback, val) end
        end)
        return Adapter
    end
    function Adapter:AddKeybind(id, options)
        options = options or {}
        mkButton(TabObject, parseTitle(options, id), "Keybind", function()
            if options.Callback then pcall(options.Callback) end
        end)
        return Adapter
    end
    Adapter.AddKeypicker = Adapter.AddKeybind
    Adapter.AddParagraph = function(self, opts)
        opts = opts or {}
        mkButton(TabObject, opts.Title or "Info", opts.Content or "", function() end)
    end
    return Adapter
end
local function ImportTabContent(TabObject, TargetSource, FallbackSetup)
    local AdaptedTab = AdaptTabForRayfield(TabObject)
    if type(TargetSource) == "function" then
        local ok, err = pcall(function() TargetSource(AdaptedTab) end)
        if not ok then
            warn("[Aether Hub] Module error: "..tostring(err))
            if FallbackSetup then FallbackSetup() end
        end
    elseif type(TargetSource) == "string" and TargetSource ~= "" and TargetSource ~= "URL_HERE" then
        local urls = string.split(TargetSource, ",")
        local executedAny = false
        for _, url in ipairs(urls) do
            local cleanUrl = url:match("^%s*(.-)%s*$")
            if cleanUrl ~= "" then
                local ok, raw = pcall(function() return game:HttpGet(cleanUrl) end)
                if ok and raw then
                    local loaded, loadErr = loadstring(raw)
                    if loaded then
                        local runOk, module = pcall(loaded)
                        if runOk then
                            if type(module) == "function" then
                                pcall(function() module(AdaptedTab) end)
                                executedAny = true
                            elseif type(module) == "table" then
                                if type(module.Init) == "function" then
                                    pcall(function() module.Init(AdaptedTab) end)
                                elseif getmetatable(module) and getmetatable(module).__call then
                                    pcall(function() module(AdaptedTab) end)
                                end
                                executedAny = true
                            end
                        else
                            warn("[Aether Hub] Runtime error: "..cleanUrl.." | "..tostring(module))
                        end
                    else
                        warn("[Aether Hub] Syntax error: "..cleanUrl.." | "..tostring(loadErr))
                    end
                else
                    warn("[Aether Hub] Failed to download: "..cleanUrl)
                end
            end
        end
        if not executedAny and FallbackSetup then FallbackSetup() end
    else
        if FallbackSetup then FallbackSetup() end
    end
end
