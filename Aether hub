        gui.DisplayOrder = 999999
        gui.Parent = CoreGui
        flyGUIRef = gui
        local function makeArrow(x, y, text, dir)
            local b = Instance.new("TextButton", gui)
            b.Size = UDim2.new(0, 58, 0, 58)
            b.Position = UDim2.new(0, x, 0, y)
            b.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
            b.BorderSizePixel = 0
            b.Text = text
            b.TextColor3 = Color3.fromRGB(240, 215, 255)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 28
            b.RichText = false
            b.AutoButtonColor = false
            Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
            local s = Instance.new("UIStroke", b)
            s.Color = COR_MAIN
            s.Thickness = 2.5
            b.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    flyMove[dir] = 1
                    b.BackgroundColor3 = Color3.fromRGB(140, 90, 230)
                end
            end)
            b.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    flyMove[dir] = 0
                    b.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
                end
            end)
        end
        makeArrow(80, 60, "▲", "up")
        makeArrow(15, 125, "◀", "left")
        makeArrow(145, 125, "▶", "right")
        makeArrow(80, 190, "▼", "down")
    end

    local function stopFly()
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyAng then flyAng:Destroy(); flyAng = nil end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        for k in pairs(flyMove) do flyMove[k] = 0 end
    end

    local function startFly()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true
        flyBV = Instance.new("BodyVelocity", root)
        flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        flyBV.Velocity = Vector3.zero
        flyAng = Instance.new("BodyAngularVelocity", root)
        flyAng.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        flyAng.AngularVelocity = Vector3.zero
        flyConn = RunService.Heartbeat:Connect(function()
            if not flyActive then return end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local cam = workspace.CurrentCamera
            local speed = 90
            local vel = Vector3.zero
            vel += cam.CFrame.RightVector * (flyMove.right - flyMove.left) * speed
            vel += cam.CFrame.LookVector * (flyMove.up - flyMove.down) * speed
            if flyBV then flyBV.Velocity = vel end
        end)
    end

    flyBtn.MouseButton1Click:Connect(function()
        flyActive = not flyActive
        flySet(flyActive)
        notificar("🕊️ Fly", flyActive and "Ativado" or "Desativado", COR_MAIN)
        if flyActive then createFlyUI() startFly() else
            if flyGUIRef then flyGUIRef:Destroy(); flyGUIRef = nil end
            stopFly()
        end
    end)

    -- FOCUS
    local focusActive = false
    local focusBtn, focusSet = makeButton(pPrincipal, "🎯 Focus", 3)
    local focusConn, focusTarget

    local function findNearest()
        local c = LP.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return nil end
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local tr = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if tr and hum and hum.Health > 0 then
                    local d = (tr.Position - r.Position).Magnitude
                    if d < bestD then bestD = d; best = p end
                end
            end
        end
        return best
    end

    local function stopFocus()
        if focusConn then focusConn:Disconnect(); focusConn = nil end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        focusTarget = nil
    end

    local function startFocus()
        focusTarget = findNearest()
        if not focusTarget then focusActive = false focusSet(false) return end
        local angle = 0
        focusConn = RunService.Heartbeat:Connect(function(dt)
            if not focusActive then return end
            if not focusTarget or not focusTarget.Character or not focusTarget.Character.Parent then
                focusTarget = findNearest()
                if not focusTarget then return end
            end
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local tr   = focusTarget.Character:FindFirstChild("HumanoidRootPart")
            local tHum = focusTarget.Character:FindFirstChildOfClass("Humanoid")
            if not root or not hum or not tr then return end
            if tHum and tHum.Health <= 0 then focusTarget = findNearest() return end
            hum.PlatformStand = true
            angle += dt * 5
            local offset = Vector3.new(math.cos(angle) * 6, 3, math.sin(angle) * 6)
            root.CFrame = CFrame.new(tr.Position + offset, tr.Position)
            root.Velocity = Vector3.zero
        end)
    end

    focusBtn.MouseButton1Click:Connect(function()
        focusActive = not focusActive
        focusSet(focusActive)
        notificar("🎯 Focus", focusActive and "Ativado" or "Desativado", COR_MAIN)
        if focusActive then startFocus() else stopFocus() end
    end)

    -- BYPASS
    local bypassActive = false
    local bypassBtn, bypassSet = makeButton(pCombate, "🔥 Bypass", 1)

    local function ExecutarBypass()
        local char = LP.Character or LP.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart", 5)
        if not root then return false end
        local sucesso = false
        pcall(function()
            local jogadores = Players:GetPlayers()
            for i = #jogadores, 1, -1 do
                if jogadores[i] == LP then table.remove(jogadores, i) end
            end
            if #jogadores > 0 then
                local alvo = jogadores[math.random(1, #jogadores)]
                if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                    local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                    root.CFrame = CFrame.new(posAlvo)
                    task.wait(0.5)
                    if (root.Position - posAlvo).Magnitude < 25 then sucesso = true end
                end
            end
        end)
        return sucesso
    end

    local function rotaDoVoid()
        pcall(function()
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end
            hum.PlatformStand = true
            local bv = Instance.new("BodyVelocity", root)
            bv.MaxForce = Vector3.new(9e6, 9e6, 9e6)
            bv.Velocity = Vector3.new(0, 150, 0)
            task.wait(1.3)
            bv.Velocity = Vector3.new(-300, 0, 0)
            task.wait(2.4)
            bv.Velocity = Vector3.zero
            hum.PlatformStand = false
            bv:Destroy()
        end)
    end

    bypassBtn.MouseButton1Click:Connect(function()
        bypassActive = not bypassActive
        bypassSet(bypassActive)
        notificar("🔥 Bypass", bypassActive and "Ativado" or "Desativado", COR_MAIN)
        if bypassActive then
            task.spawn(function()
                while bypassActive do
                    if ExecutarBypass() then
                        bypassActive = false
                        bypassSet(false)
                        notificar("🔥 Bypass", "✅ Completado!", Color3.fromRGB(60, 220, 120))
                        break
                    else
                        rotaDoVoid()
                        task.wait(3)
                    end
                end
            end)
        end
    end)

    -- AIM LOCK
    local aimActive = false
    local aimBtn, aimSet = makeButton(pCombate, "🎯 Aim Lock", 2)
    local aimConn = nil
    local AIM_FOV = 300

    local function getNearestHead()
        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local best, bestD = nil, AIM_FOV
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local hrp  = p.Character:FindFirstChild("HumanoidRootPart")
                local hum  = p.Character:FindFirstChildOfClass("Humanoid")
                if head and hrp and hum and hum.Health > 0 then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d < bestD then bestD = d; best = head end
                end
            end
        end
        return best
    end

    aimBtn.MouseButton1Click:Connect(function()
        aimActive = not aimActive
        aimSet(aimActive)
        notificar("🎯 Aim Lock", aimActive and "Ativado" or "Desativado", COR_MAIN)
        if aimActive then
            if not aimConn then
                aimConn = RunService.RenderStepped:Connect(function()
                    if not aimActive then return end
                    local t = getNearestHead()
                    if not t or not t.Parent then return end
                    local cam = workspace.CurrentCamera
                    if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, t.Position) end
                end)
            end
        else
            if aimConn then aimConn:Disconnect(); aimConn = nil end
        end
    end)

