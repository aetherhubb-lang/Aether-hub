        if not mh then break end
        if (mh.Position - t.Root.Position).Magnitude > 20 then
            mh.CFrame = t.Root.CFrame * CFrame.new(0,3,-5)
            task.wait(0.1)
        end
        local last = 0
        while autoBypassOn and t.Human and t.Human.Health > 0 and t.Root and t.Root.Parent do
            if fugindo then break end
            if gUltReady() then return true end
            mc = getChar()
            mh = mc and mc:FindFirstChild("HumanoidRootPart")
            if not mh then break end
            total += 8 * rs.Heartbeat:Wait()
            local vx, vz = math.cos(total)*5, math.sin(total)*5
            mh.CFrame = CFrame.lookAt(t.Root.Position + Vector3.new(vx,1,vz), t.Root.Position)
            if tick() - last > 0.2 and (mh.Position - t.Root.Position).Magnitude < 15 then
