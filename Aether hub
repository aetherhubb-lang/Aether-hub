-- 2. AC Bypass
local bOn = false
local bConn
local function resetB()
    bOn = false
    local h = getHum()
    if h then h.PlatformStand = false end
    local r = getHRP()
    if r then
        for _, n in ipairs({"PrimeVel","PrimeGyro"}) do
            local o = r:FindFirstChild(n)
            if o then o:Destroy() end
        end
    end
    if bConn then bConn:Disconnect() bConn = nil end
end
mkCard(pFunc,"️ AC Bypass","Voo anti-fling até zona segura",function(a)
    bOn = a
    if not a then return resetB() end
    local alvo = Vector3.new(372.105, 61.47, 394.779)
    local et = 1
    bConn = rs.RenderStepped:Connect(function()
        local r = getHRP()
        local h = getHum()
        if not r or not h or h.Health <= 0 then return resetB() end
        h.PlatformStand = true
        local v = r:FindFirstChild("PrimeVel")
        if not v then
            v = Instance.new("BodyVelocity")
            v.Name = "PrimeVel"
            v.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            v.Velocity = Vector3.zero
            v.Parent = r
        end
        local g = r:FindFirstChild("PrimeGyro")
        if not g then
            g = Instance.new("BodyGyro")
            g.Name = "PrimeGyro"
            g.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            g.Parent = r
        end
        if et == 1 then
            g.CFrame = CFrame.new(r.Position, Vector3.new(r.Position.X, 380, r.Position.Z))
            local d = 380 - r.Position.Y
            if math.abs(d) > 5 then
                v.Velocity = Vector3.new(0, math.clamp(d*30, -1000, 1000), 0)
            else
                et = 2
            end
        elseif et == 2 then
            local vv = Vector3.new(alvo.X, 380, alvo.Z)
            g.CFrame = CFrame.new(r.Position, vv)
            if (vv - Vector3.new(r.Position.X, 380, r.Position.Z)).Magnitude > 15 then
                v.Velocity = (vv - r.Position).Unit * 1000
            else
                et = 3
            end
        elseif et == 3 then
            g.CFrame = CFrame.new(r.Position, alvo)
            local d = alvo.Y - r.Position.Y
            if math.abs(d) > 5 then
                v.Velocity = Vector3.new(0, math.clamp(d*30, -800, 800), 0)
            else
                resetB()
            end
        end
    end)
end)
-- 3. Bypass helpers
local function ExecutarBypass()
    local c = lp.Character or lp.CharacterAdded:Wait()
    local r = c:WaitForChild("HumanoidRootPart", 5)
    if not r then return false end
    local sucesso = false
    pcall(function()
        local jogadores = players:GetPlayers()
        for i = #jogadores, 1, -1 do
            if jogadores[i] == lp then table.remove(jogadores, i) end
        end
        if #jogadores > 0 then
            local alvo = jogadores[math.random(1, #jogadores)]
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local pos = alvo.Character.HumanoidRootPart.Position + Vector3.new(0,3,0)
                r.CFrame = CFrame.new(pos)
                task.wait(0.5)
                if r and r.Parent and (r.Position - pos).Magnitude < 25 then
                    sucesso = true
                end
            end
        end
    end)
    return sucesso
end
local function rotaDoVoid()
    pcall(function()
        local r = getHRP()
        local h = getHum()
        if not r or not h then return end
        h.PlatformStand = true
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e6, 9e6, 9e6)
        bv.Velocity = Vector3.new(0, 150, 0)
        bv.Parent = r
        task.wait(1.3)
        bv.Velocity = Vector3.new(-300, 0, 0)
        task.wait(2.4)
        bv.Velocity = Vector3.zero
        h.PlatformStand = false
        bv:Destroy()
    end)
end
-- 4. Bypass Auto
local bypassAutoTask = nil
local bypassAutoOn = false
local function rodarBypassAuto(callbackSucesso)
    if bypassAutoTask then return end
    bypassAutoOn = true
    bypassAutoTask = task.spawn(function()
        local sucesso = false
        local tentativas = 0
        while not sucesso and tentativas < 20 and bypassAutoOn do
            tentativas = tentativas + 1
            sLabel.Text = "Bypass tentativa #"..tentativas
            sLabel.TextColor3 = C.VN
            sucesso = ExecutarBypass()
            if sucesso then
                sLabel.Text = "Bypass OK! (#"..tentativas..")"
                sLabel.TextColor3 = C.VN
            else
                sLabel.Text = "Falhou, rota do void..."
                sLabel.TextColor3 = C.R
                rotaDoVoid()
                task.wait(5)
            end
        end
        bypassAutoOn = false
        bypassAutoTask = nil
        if sucesso then
            task.wait(1)
            if callbackSucesso then pcall(callbackSucesso) end
        else
            sLabel.Text = "Bypass falhou"
            sLabel.TextColor3 = C.R
            task.wait(3)
            sLabel.Text = "Sem Serviço"
            sLabel.TextColor3 = C.TS
        end
    end)
end
mkButton(pFunc," Bypass Auto","Tenta até funcionar",function() rodarBypassAuto(nil) end)
-- 5. Teste Bypass
mkButton(pFunc," Teste Bypass","Testa o bypass uma vez",function()
    task.spawn(function()
        sLabel.Text = "Testando bypass..."
        sLabel.TextColor3 = C.TS
        local ok = ExecutarBypass()
        if ok then
            sLabel.Text = "✅ Bypass Ativado!"
            sLabel.TextColor3 = C.VN
        else
            sLabel.Text = "❌ Bypass Desativado"
            sLabel.TextColor3 = C.R
            rotaDoVoid()
        end
        task.delay(3, function()
            sLabel.Text = "Sem Serviço"
            sLabel.TextColor3 = C.TS
        end)
    end)
end)
