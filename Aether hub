    local uo = lp:FindFirstChild("Ultimate") or lp:FindFirstChild("UltBar")
    if uo and uo:IsA("NumberValue") and uo.Value >= 100 then return true end
    local pg = lp:FindFirstChild("PlayerGui")
    if pg then
        for _, s in ipairs(pg:GetChildren()) do
