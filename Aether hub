    MinCorner.Parent = MinimizeBtn

    -- Botão Cadeado
    local LockBtn = Instance.new("TextButton")
    LockBtn.Size = UDim2.new(0, 25, 0, 25)
    LockBtn.Position = UDim2.new(1, -30, 0, 7)
    LockBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    LockBtn.Text = "🔓"
    LockBtn.TextSize = 12
    LockBtn.Parent = TopBar

    local LockCorner = Instance.new("UICorner")
    LockCorner.CornerRadius = UDim.new(0, 6)
    LockCorner.Parent = LockBtn

    -- Botão Flutuante (+)
    local OpenBtn = Instance.new("TextButton")
    OpenBtn.Size = UDim2.new(0, 45, 0, 45)
    OpenBtn.Position = UDim2.new(0.05, 0, 0.2, 0)
    OpenBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    OpenBtn.Text = "+"
    OpenBtn.TextColor3 = Color3.fromRGB(120, 80, 255)
    OpenBtn.TextSize = 24
    OpenBtn.Font = Enum.Font.GothamBold
    OpenBtn.Visible = false
