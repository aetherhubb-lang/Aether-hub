local function mkCard(parent, titulo, desc, cb)
    local cd, cst = baseCard(parent, titulo, desc)
    local atv = false
    cd.MouseButton1Click:Connect(function()
        atv = not atv
        if atv then
            ts:Create(cd,tf,{BackgroundColor3=C.G,BackgroundTransparency=0.35}):Play()
            ts:Create(cst,tf,{Color=C.VN,Transparency=0}):Play()
        else
            ts:Create(cd,tf,{BackgroundColor3=C.F,BackgroundTransparency=0.4}):Play()
            ts:Create(cst,tf,{Color=C.VE,Transparency=0.7}):Play()
        end
        if cb then pcall(cb, atv, cd) end
    end)
    return cd
end

