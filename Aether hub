local function gNearest()
    local mc = getChar()
    local mh = mc and mc:FindFirstChild("HumanoidRootPart")
    if not mh then return nil end
    local n, d = nil, math.huge
    local function isPlayerModel(model)
        if not model then return true end
        for _, p in ipairs(players:GetPlayers()) do
            if p.Character == model then return true end
        end
        return false
    end
    for _, o in ipairs(workspace:GetChildren()) do
        if o:IsA("Model") and o ~= mc and not isPlayerModel(o) then
            local h = o:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local r = o:FindFirstChild("HumanoidRootPart") or o:FindFirstChild("Torso")
                if r then
                    local dd = (r.Position - mh.Position).Magnitude
                    if dd < d then d = dd n = {Root=r, Human=h, Model=o} end
                end
            end
        end
    end
    return n
end

