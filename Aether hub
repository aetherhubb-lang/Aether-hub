    end)

    local focusOn = false
    local focusB = mkBtn("Focus: OFF", 4)
    local focusC, focusT

    local function findNear()
        local c = LP.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return nil end
        local b, bd = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local tr = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if tr and h and h.Health > 0 then
                    local d = (tr.Position - r.Position).Magnitude
                    if d < bd then bd = d b = p end
                end
            end
        end
        return b
    end

    local function stopFocus()
        if focusC then focusC:Disconnect() focusC = nil end
        local c = LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
        focusT = nil
    end

    local function startFocus()
        focusT = findNear()
        if not focusT then focusOn = false focusB.Text = "Focus: OFF" return end
        local ang = 0
        focusC = RunService.Heartbeat:Connect(function(dt)
            if not focusOn then return end
            if not focusT or not focusT.Character or not focusT.Character.Parent then
                focusT = findNear()
                if not focusT then return end
            end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local tr = focusT.Character:FindFirstChild("HumanoidRootPart")
            if not r or not h or not tr then return end
            h.PlatformStand = true
            ang = ang + dt * 5
            local off = Vector3.new(math.cos(ang) * 6, 3, math.sin(ang) * 6)
            r.CFrame = CFrame.new(tr.Position + off, tr.Position)
            r.Velocity = Vector3.zero
        end)
    end

    focusB.MouseButton1Click:Connect(function()
        focusOn = not focusOn
        focusB.Text = "Focus: " .. (focusOn and "ON" or "OFF")
        if focusOn then startFocus() else stopFocus() end
    end)

