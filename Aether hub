local holds = {Forward = false, Back = false, Left = false, Right = false, Up = false, Down = false}

local function bindHold(btn, key)
    btn.MouseButton1Down:Connect(function() holds[key] = true end)
    btn.MouseButton1Up:Connect(function() holds[key] = false end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then holds[key] = true end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then holds[key] = false end
    end)
end

