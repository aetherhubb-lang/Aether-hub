    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(190, 150, 255)
    stroke.Thickness = 2
    stroke.Transparency = 0.1
    stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 45)
    title.Position = UDim2.new(0, 0, 0, 12)
    title.BackgroundTransparency = 1
    title.Text = "🌌 AETHER HUB"
    title.TextColor3 = Color3.fromRGB(210, 170, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 22
    title.Parent = frame

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, 0, 0, 20)
    sub.Position = UDim2.new(0, 0, 0, 55)
    sub.BackgroundTransparency = 1
    sub.Text = "Digite a Key de Acesso"
    sub.TextColor3 = Color3.fromRGB(160, 130, 200)
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 12
    sub.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 230, 0, 36)
    box.Position = UDim2.new(0.5, -115, 0, 88)
    box.BackgroundColor3 = Color3.fromRGB(35, 20, 55)
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = "Digite sua key..."
    box.TextColor3 = Color3.fromRGB(220, 200, 255)
    box.PlaceholderColor3 = Color3.fromRGB(130, 100, 180)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 230, 0, 36)
    btn.Position = UDim2.new(0.5, -115, 0, 134)
    btn.BackgroundColor3 = Color3.fromRGB(140, 80, 230)
    btn.BorderSizePixel = 0
    btn.Text = "Verificar"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 18)
    status.Position = UDim2.new(0, 0, 0, 180)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(220, 80, 100)
    status.Font = Enum.Font.Gotham
    status.TextSize = 12
    status.Parent = frame

    local function tryVerify()
        local keyDigitada = box.Text
        if keyDigitada == "" then
            status.Text = "✘ Digite uma key!"
            return
        end
        local idEsperado = KeysAutorizadas[keyDigitada]
        if not idEsperado then
            status.Text = "✘ Key inválida"
            box.Text = ""
            return
        end
        if idEsperado ~= LP.UserId then
            status.Text = "✘ Key não pertence a você"
            return
        end
        status.Text = "✔ Acesso Concedido"
        status.TextColor3 = Color3.fromRGB(60, 200, 100)
        task.wait(0.9)
        gui:Destroy()
        _G.AetherAuthenticated = true
        loadMainHub()
    end

    btn.MouseButton1Click:Connect(tryVerify)
    box.FocusLost:Connect(function(enter)
        if enter then tryVerify() end
    end)
end

