-- [[ FUNÇÃO GOJO 0.2s DOMAIN + KILL ALL ]] --
local GojoComboActive = false

local function TriggerGojo02sDomain()
    local char = LocalPlayer.Character
    if not char then return end

    local tool = char:FindFirstChild("0.2s Domain Expansion") or char:FindFirstChild("0.2s Domain") or char:FindFirstChild("Domain Expansion") or LocalPlayer.Backpack:FindFirstChild("0.2s Domain Expansion")
    if tool then
        tool.Parent = char
        task.wait(0.1)
        tool:Activate()
    end

    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (string.find(string.lower(obj.Name), "domain") or string.find(string.lower(obj.Name), "skill") or string.find(string.lower(obj.Name), "0.2")) then
            pcall(function()
                obj:FireServer("0.2s Domain", true)
            end)
        end
    end
end

local function AttackTarget(target)
    local char = LocalPlayer.Character
    if not char then return end

    local activeTool = char:FindFirstChildOfClass("Tool")
    if activeTool then
        activeTool:Activate()
    end

    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (string.find(string.lower(obj.Name), "m1") or string.find(string.lower(obj.Name), "attack") or string.find(string.lower(obj.Name), "hit") or string.find(string.lower(obj.Name), "damage")) then
            pcall(function()
                obj:FireServer(target.Character, target.Character:FindFirstChild("HumanoidRootPart"))
            end)
        end
    end
end

AddButton(TabGojo, "Gojo: 0.2s Domain + Kill All", function()
    GojoComboActive = not GojoComboActive
    
    if GojoComboActive then
        task.spawn(function()
            TriggerGojo02sDomain()
            task.wait(0.3)

            while GojoComboActive do
                for _, target in pairs(Players:GetPlayers()) do
                    if not GojoComboActive then break end
                    if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChild("Humanoid") then
                        if target.Character.Humanoid.Health > 0 then
                            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if myHrp then
                                myHrp.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -1.5)
                            end

                            AttackTarget(target)
                            
                            -- VELOCIDADE REDUZIDA (Focus/Intervalo ajustado)
                            task.wait(0.7)
                        end
                    end
                end
                task.wait(0.2)
            end
        end)
    end
end)

