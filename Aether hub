    GojoBtn.Text = gojoActive and "Gojo 0.2 [ON]" or "Gojo 0.2 [OFF]"
    GojoBtn.BackgroundColor3 = gojoActive and BUTTON_ON or BUTTON_OFF

    if gojoActive then
        gojoThread = task.spawn(function()
            while gojoActive do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                            local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                            if tHum and tHum.Health > 0 and tHrp and gojoActive then
                                hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 2)
                                task.wait(0.05)
                            end
                        end
                    end
                end
                task.wait(0.05)
            end
        end)
    end
end)

-- ==================== FUNÇÃO 2: FLY MOBILE ====================
local flyActive = false
local FlyGui = Instance.new("Frame")
FlyGui.Size = UDim2.new(1, 0, 1, 0)
